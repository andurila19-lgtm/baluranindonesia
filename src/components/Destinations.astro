---
import { otherDestinationsData, siteConfig } from '../data/baluranData';
---

<section class="section destinations-section" id="destinasi-lainnya">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title" data-i18n="section.dest_title">Destinasi Lainnya</h2>
        <p class="section-subtitle" data-i18n="section.dest_sub">Selain Baluran, kami juga melayani perjalanan ke destinasi wisata populer di sekitar Banyuwangi.</p>
      </div>
      <a href="/destinasi" class="section-link">
        <span data-i18n="common.view_all_dest">Lihat Semua Destinasi</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <div class="destinations-grid">
      {otherDestinationsData.map((dest) => (
        <article class="dest-card">
          <div class="dest-image-wrap">
            <img 
              src={dest.image} 
              alt={dest.title} 
              class="dest-img" 
              loading="lazy"
            />
          </div>

          <div class="dest-content">
            <h3 class="dest-title" data-i18n={dest.id === 'kawah-wurung' ? 'dest.kw.title' : 'dest.dj.title'}>{dest.title}</h3>
            
            <div class="dest-price-wrap">
              <span class="price-val">{dest.priceFormatted}</span>
              <span class="price-unit" data-i18n="common.per_jeep">{dest.unit}</span>
            </div>

            <div class="dest-meta">
              <div class="meta-item">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span data-i18n={dest.id === 'kawah-wurung' ? 'dest.kw.duration' : 'dest.dj.duration'}>{dest.duration}</span>
              </div>
              <div class="meta-item">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                </svg>
                <span data-i18n="common.max_cap">{dest.capacity}</span>
              </div>
            </div>

            <div class="dest-actions">
              <button 
                type="button" 
                class="btn-outline open-dest-modal-btn" 
                data-dest-id={dest.id}
              >
                <span data-i18n="common.see_detail">Lihat Detail</span>
                <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <a 
                href={siteConfig.whatsappUrl(`Halo Baluran Indonesia, saya tertarik dengan ${dest.title} ${dest.priceFormatted}. Mohon info ketersediaan armada.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="dest-wa-quick"
                aria-label={`Pesan ${dest.title} via WhatsApp`}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16Z"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .destinations-section {
    background-color: #ffffff;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .dest-card {
    background: #ffffff;
    border: 1px solid #eef2f0;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .dest-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
  }

  .dest-image-wrap {
    width: 44%;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .dest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .dest-card:hover .dest-img {
    filter: brightness(1.03);
  }

  .dest-content {
    padding: 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 56%;
  }

  .dest-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.35rem;
  }

  .dest-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .price-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: #15803d;
    letter-spacing: -0.02em;
  }

  .price-unit {
    font-size: 0.8rem;
    color: #6b7280;
  }

  .dest-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #4b5563;
  }

  .dest-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .open-dest-modal-btn {
    flex: 1;
    font-size: 0.82rem;
    padding: 0.5rem 0.85rem;
  }

  .dest-wa-quick {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ecfdf5;
    color: #15803d;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .dest-wa-quick:hover {
    background: #15803d;
    color: #ffffff;
  }

  @media (max-width: 820px) {
    .destinations-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .dest-card {
      flex-direction: column;
    }
    .dest-image-wrap {
      width: 100%;
      height: 180px;
    }
    .dest-content {
      width: 100%;
    }
  }
</style>
