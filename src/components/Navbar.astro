---
import { siteConfig } from '../data/baluranData';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Beranda', href: '/', i18nKey: 'nav.home' },
  { label: 'Paket Jeep Baluran', href: '/paket', i18nKey: 'nav.packages' },
  { label: 'Destinasi Lainnya', href: '/destinasi', i18nKey: 'nav.destinations' },
  { label: 'Harga', href: '/harga', i18nKey: 'nav.pricing' },
  { label: 'Tentang Kami', href: '/tentang-kami', i18nKey: 'nav.about' },
  { label: 'Panduan', href: '/panduan', i18nKey: 'nav.guide' },
  { label: 'Kontak', href: '/kontak', i18nKey: 'nav.contact' },
];

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="navbar">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Baluran Indonesia Beranda">
      <div class="logo-icon">
        <svg viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="mountain-svg">
          <path d="M12 28L2 28L13 10L19 19L23 13L33 28H23" stroke="#1b3d2f" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M18 28L25 18L38 28H18Z" fill="#15803d" fill-opacity="0.25" stroke="#15803d" stroke-width="2" stroke-linejoin="round" />
          <path d="M7 28L15 15L21 24" stroke="#22c55e" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-title">BALURAN</span>
        <span class="logo-subtitle">INDONESIA</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Navigasi Utama">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class:list={['nav-link', { active: isActive(item.href) }]}
              data-i18n={item.i18nKey}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Language Switcher (Desktop & Mobile) -->
      <div class="lang-switch" id="langSwitch" title="Ganti Bahasa / Change Language">
        <button type="button" class="lang-btn active" data-lang="id" aria-label="Bahasa Indonesia">ID</button>
        <span class="lang-divider">|</span>
        <button type="button" class="lang-btn" data-lang="en" aria-label="English">EN</button>
      </div>

      <!-- WhatsApp CTA -->
      <a 
        href={siteConfig.whatsappUrl('Halo Baluran Indonesia, saya ingin reservasi Jeep Safari Baluran.')} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-wa nav-wa-btn"
        aria-label="Chat WhatsApp 085333050863"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
        </svg>
        <span class="phone-number">{siteConfig.whatsappFormatted}</span>
      </a>

      <!-- Mobile Hamburger Button with Cross Animation -->
      <button type="button" class="mobile-toggle" id="mobileMenuBtn" aria-label="Buka Menu Navigasi" aria-expanded="false">
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
        <span class="hamburger-line line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Floating Backdrop Overlay -->
  <div class="mobile-backdrop" id="mobileBackdrop" aria-hidden="true"></div>

  <!-- Mobile Floating Drawer Card -->
  <div class="mobile-floating-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Menu Navigasi Mobile">
    <div class="mobile-drawer-inner">
      <div class="mobile-top-bar">
        <span class="mobile-menu-label">Navigasi Utama</span>
        <div class="mobile-lang-wrap">
          <button type="button" class="lang-btn active" data-lang="id">ID</button>
          <span class="lang-divider">|</span>
          <button type="button" class="lang-btn" data-lang="en">EN</button>
        </div>
      </div>

      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class:list={['mobile-nav-link', { active: isActive(item.href) }]}
              data-i18n={item.i18nKey}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-drawer-cta">
        <a 
          href={siteConfig.whatsappUrl('Halo Baluran Indonesia, saya ingin reservasi Jeep Safari.')} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-wa full-width"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
          </svg>
          <span data-i18n="common.chat_wa">Chat WhatsApp:</span> {siteConfig.whatsappFormatted}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #ffffff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .mountain-svg {
    width: 38px;
    height: 32px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #1a3323;
  }

  .logo-subtitle {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #15803d;
  }

  /* Nav Links */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: #4b5563;
    transition: color 0.2s ease;
    padding: 0.35rem 0;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: #111827;
  }

  .nav-link.active {
    font-weight: 700;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #15803d;
    border-radius: 2px;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    background: #f3f4f6;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 0.3rem;
    border: 1px solid #e5e7eb;
  }

  .lang-btn {
    color: #6b7280;
    padding: 0.15rem 0.35rem;
    font-size: 0.74rem;
    font-weight: 700;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .lang-btn.active {
    color: #15803d;
    background: #ffffff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .lang-divider {
    color: #d1d5db;
    font-size: 0.7rem;
  }

  .nav-wa-btn {
    padding: 0.5rem 1.15rem;
    font-size: 0.82rem;
    background-color: #168b48;
  }

  .phone-number {
    letter-spacing: 0.02em;
  }

  /* Mobile hamburger with transform to X */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 10px;
    background: #f8faf9;
    border: 1px solid #e5e7eb;
    transition: background-color 0.2s ease;
  }

  .hamburger-line {
    width: 20px;
    height: 2px;
    background-color: #1f2937;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Hamburger to Cross X when open */
  .mobile-toggle.open .line-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.open .line-2 {
    opacity: 0;
  }

  .mobile-toggle.open .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ====================================================
     FLOATING MOBILE DRAWER & BACKDROP (MENGAMBANG + FIX SCROLL)
     ==================================================== */

  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 105;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-backdrop.open {
    display: block;
    opacity: 1;
  }

  .mobile-floating-drawer {
    display: none;
    position: fixed;
    top: 80px;
    left: 1rem;
    right: 1rem;
    max-height: calc(100vh - 100px);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(22, 101, 52, 0.16);
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.05);
    z-index: 110;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-floating-drawer.open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-drawer-inner {
    padding: 1.5rem 1.6rem 1.85rem;
  }

  .mobile-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .mobile-menu-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #6b7280;
    letter-spacing: 0.08em;
  }

  .mobile-lang-wrap {
    display: inline-flex;
    align-items: center;
    background: #f3f4f6;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    gap: 0.25rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-nav-link {
    font-size: 1rem;
    font-weight: 600;
    color: #1f2937;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    border-radius: 12px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: #ecfdf5;
    color: #15803d;
  }

  .mobile-drawer-cta {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #f3f4f6;
  }

  .full-width {
    width: 100%;
  }

  @media (max-width: 880px) {
    .header-container {
      height: 60px;
    }
    .desktop-nav {
      display: none;
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .header-actions .lang-switch {
      display: inline-flex;
      padding: 0.18rem 0.45rem;
      font-size: 0.7rem;
    }
    .header-actions .nav-wa-btn {
      display: none;
    }
    .mobile-toggle {
      display: flex;
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  import { initI18n, setLanguage, toggleLanguage } from '../scripts/i18n';

  // Initialize Language Switcher
  initI18n();

  // Attach language button and container listeners across desktop and mobile
  document.querySelectorAll('.lang-switch, .mobile-lang-wrap').forEach(container => {
    container.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.lang-btn');
      if (target) {
        const lang = (target.getAttribute('data-lang') as 'id' | 'en') || 'id';
        setLanguage(lang);
      } else {
        toggleLanguage();
      }
    });
  });

  // Mobile Floating Drawer & Scroll Lock
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const mobileBackdrop = document.getElementById('mobileBackdrop');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMobileMenu() {
    if (!mobileBtn || !mobileDrawer || !mobileBackdrop) return;
    mobileBtn.classList.add('open');
    mobileBtn.setAttribute('aria-expanded', 'true');
    mobileDrawer.classList.add('open');
    mobileBackdrop.classList.add('open');
    // Lock background scroll
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    if (!mobileBtn || !mobileDrawer || !mobileBackdrop) return;
    mobileBtn.classList.remove('open');
    mobileBtn.setAttribute('aria-expanded', 'false');
    mobileDrawer.classList.remove('open');
    mobileBackdrop.classList.remove('open');
    // Restore background scroll
    document.body.style.overflow = '';
  }

  if (mobileBtn) {
    mobileBtn.addEventListener('click', () => {
      const isOpen = mobileBtn.classList.contains('open');
      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', closeMobileMenu);
  }

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Header shadow on scroll
  const header = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
  });
</script>
