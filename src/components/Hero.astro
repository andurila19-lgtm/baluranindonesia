---
import { siteConfig } from '../data/baluranData';

const quickRoutes = [
  {
    id: 'banyuwangi',
    label: 'Baluran (Start Kota)',
    price: 'Rp750.000',
    duration: '5 Jam',
    pickup: 'Hotel / Stasiun / Bandara Banyuwangi',
    desc: 'Layanan terfavorit, praktis dijemput langsung di hotel atau stasiun.',
    msg: 'Halo Baluran Indonesia, saya ingin pesan Paket Baluran (Start Banyuwangi Kota) Rp750.000.'
  },
  {
    id: 'pintu-masuk',
    label: 'Baluran (Start Gate)',
    price: 'Rp650.000',
    duration: '4 Jam',
    pickup: 'Meeting Point Pintu Masuk Baluran (Batangan)',
    desc: 'Pilihan hemat bagi Anda yang datang membawa kendaraan pribadi.',
    msg: 'Halo Baluran Indonesia, saya ingin pesan Paket Baluran (Start Pintu Masuk) Rp650.000.'
  },
  {
    id: 'kawah-wurung',
    label: 'Kawah Wurung',
    price: 'Rp900.000',
    duration: '6–7 Jam',
    pickup: 'Area Banyuwangi Kota',
    desc: 'Savana hijau berbukit bak Selandia Baru di kaki Gunung Ijen.',
    msg: 'Halo Baluran Indonesia, saya ingin pesan Paket Kawah Wurung Rp900.000.'
  },
  {
    id: 'de-djawatan',
    label: 'Hutan De Djawatan',
    price: 'Rp700.000',
    duration: '5 Jam',
    pickup: 'Area Banyuwangi Kota',
    desc: 'Hutan trembesi raksasa berusia ratusan tahun bernuansa Lord of the Rings.',
    msg: 'Halo Baluran Indonesia, saya ingin pesan Paket Hutan De Djawatan Rp700.000.'
  }
];
---

<section class="hero-section" id="hero">
  <!-- Atmospheric Background with Gentle Cinematic Drift (NO SCALE) -->
  <div class="hero-bg-wrapper">
    <div class="hero-bg-pan">
      <img 
        src="/images/hero-baluran.jpg" 
        alt="Jeep Safari Baluran Indonesia di Savana Bekol berlatar Gunung Baluran" 
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-gradient-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-main-grid">
      <!-- Left Hero Typography & Main CTAs -->
      <div class="hero-content">
        <div class="hero-badge-wrap animate-fade-up">
          <div class="hero-official-badge">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span data-i18n="hero.tag">OPERATOR RESMI JEEP SAFARI BALURAN</span>
          </div>
        </div>

        <h1 class="hero-title animate-fade-up delay-100" data-i18n="hero.title">
          Jelajahi Taman Nasional Baluran dengan Jeep Safari
        </h1>

        <p class="hero-desc animate-fade-up delay-200" data-i18n="hero.desc">
          Sensasi petualangan melintasi savana emas <em>Africa van Java</em>, mengamati satwa liar, dan pesona Pantai Bama bersama operator Jeep lokal berpengalaman.
        </p>

        <!-- Primary Quick Actions -->
        <div class="hero-actions animate-fade-up delay-300">
          <a 
            href={siteConfig.whatsappUrl('Halo Baluran Indonesia, saya ingin konsultasi & booking Jeep Safari Baluran.')} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hero-primary-btn"
            id="heroMainWaBtn"
            aria-label="Chat WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
            </svg>
            <span data-i18n="hero.book_now">Booking Sekarang</span>
          </a>

          <a href="/paket" class="hero-secondary-btn">
            <span data-i18n="hero.view_packages">Lihat Semua Paket</span>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Interactive Bespoke Route Finder Widget -->
      <div class="hero-interactive-card animate-fade-up delay-300">
        <div class="widget-header">
          <div class="widget-badge" data-i18n="widget.badge">PILIH RUTE CEPAT</div>
          <h3 class="widget-title" data-i18n="widget.title">Eksplorasi Rute Favorit</h3>
          <p class="widget-sub" data-i18n="widget.sub">Klik rute untuk cek tarif & langsung pesan:</p>
        </div>

        <!-- Route Tabs Selector -->
        <div class="route-tabs-nav" role="tablist">
          {quickRoutes.map((route, idx) => (
            <button 
              type="button" 
              class:list={['route-tab-btn', { active: idx === 0 }]}
              data-route-id={route.id}
              data-price={route.price}
              data-duration={route.duration}
              data-pickup={route.pickup}
              data-desc={route.desc}
              data-msg={route.msg}
            >
              {route.label}
            </button>
          ))}
        </div>

        <!-- Dynamic Route Preview Panel -->
        <div class="widget-preview-panel">
          <div class="preview-price-row">
            <div>
              <span class="preview-price-label" data-i18n="widget.price_label">Tarif Sewa 1 Jeep:</span>
              <div class="preview-price-val" id="quickRoutePrice">{quickRoutes[0].price}</div>
            </div>
            <div class="preview-cap-badge" data-i18n="widget.cap">Maks. 5–6 Orang</div>
          </div>

          <div class="preview-specs-box">
            <div class="p-spec-item">
              <span class="p-spec-label" data-i18n="widget.duration_label">Durasi:</span>
              <strong id="quickRouteDuration">{quickRoutes[0].duration}</strong>
            </div>
            <div class="p-spec-item">
              <span class="p-spec-label" data-i18n="widget.pickup_label">Penjemputan:</span>
              <strong id="quickRoutePickup">{quickRoutes[0].pickup}</strong>
            </div>
          </div>

          <p class="preview-desc-text" id="quickRouteDesc">{quickRoutes[0].desc}</p>

          <a 
            href={siteConfig.whatsappUrl(quickRoutes[0].msg)} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-wa full-width widget-book-btn"
            id="quickRouteBookBtn"
            data-i18n="widget.book_btn"
          >
            Pesan Rute Ini via WhatsApp
          </a>
        </div>

        <!-- Live Trust Mini Bar inside card -->
        <div class="widget-trust-footer">
          <span data-i18n="widget.trust1">✓ BBM & Driver Termasuk</span>
          <span data-i18n="widget.trust2">✓ Tanpa Calo</span>
          <span data-i18n="widget.trust3">✓ Driver Ramah</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Trust Badges Command Bar -->
  <div class="trust-bar animate-fade-up delay-500">
    <div class="container trust-container">
      <div class="trust-item">
        <div class="trust-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="11" rx="2"></rect>
            <circle cx="7" cy="18" r="2"></circle>
            <circle cx="17" cy="18" r="2"></circle>
            <path d="M2 12H22M6 7L8 3H16L18 7"></path>
          </svg>
        </div>
        <div class="trust-text">
          <div class="trust-title" data-i18n="trust.fleet_title">Armada Jeep Milik Sendiri</div>
          <div class="trust-sub" data-i18n="trust.fleet_sub">Terawat, bersih, & siap safari</div>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="trust-text">
          <div class="trust-title" data-i18n="trust.pickup_title">Penjemputan Fleksibel</div>
          <div class="trust-sub" data-i18n="trust.pickup_sub">Bandara, Stasiun, & Hotel Banyuwangi</div>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22S2 18 2 12V5L12 2L22 5V12C22 18 12 22 12 22Z"></path>
            <path d="M9 12L11 14L15 10" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="trust-text">
          <div class="trust-title" data-i18n="trust.price_title">Harga Jujur & Terbuka</div>
          <div class="trust-sub" data-i18n="trust.price_sub">Tanpa ada biaya tersembunyi</div>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
            <line x1="8" y1="2" x2="8" y2="18"></line>
            <line x1="16" y1="6" x2="16" y2="22"></line>
          </svg>
        </div>
        <div class="trust-text">
          <div class="trust-title" data-i18n="trust.driver_title">Driver Pemandu & Foto</div>
          <div class="trust-sub" data-i18n="trust.driver_sub">Paham spot foto estetik Baluran</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.route-tab-btn');
  const priceDisplay = document.getElementById('quickRoutePrice');
  const durDisplay = document.getElementById('quickRouteDuration');
  const pickDisplay = document.getElementById('quickRoutePickup');
  const descDisplay = document.getElementById('quickRouteDesc');
  const bookBtn = document.getElementById('quickRouteBookBtn') as HTMLAnchorElement;

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const price = btn.getAttribute('data-price') || '';
      const dur = btn.getAttribute('data-duration') || '';
      const pickup = btn.getAttribute('data-pickup') || '';
      const desc = btn.getAttribute('data-desc') || '';
      const msg = btn.getAttribute('data-msg') || '';

      if (priceDisplay) priceDisplay.textContent = price;
      if (durDisplay) durDisplay.textContent = dur;
      if (pickDisplay) pickDisplay.textContent = pickup;
      if (descDisplay) descDisplay.textContent = desc;

      if (bookBtn) {
        bookBtn.href = `https://wa.me/6285333050863?text=${encodeURIComponent(msg)}`;
      }
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    overflow: hidden;
  }

  /* Cinematic Gentle Drift Pan (NO SCALING) */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-pan {
    width: 105%;
    height: 105%;
    position: absolute;
    top: -2.5%;
    left: -2.5%;
    animation: gentlePan 30s ease-in-out infinite alternate;
  }

  @keyframes gentlePan {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-15px, -10px, 0);
    }
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.6) 0%,
      rgba(15, 23, 42, 0.5) 40%,
      rgba(15, 23, 42, 0.88) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  /* Verified Official Operator Badge (No dots / bullets) */
  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-official-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(22, 101, 52, 0.45);
    border: 1px solid rgba(74, 222, 128, 0.35);
    color: #86efac;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-official-badge svg {
    color: #4ade80;
    flex-shrink: 0;
  }

  .hero-main-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* Content */
  .hero-content {
    max-width: 620px;
  }

  .hero-title {
    font-size: 2.85rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero-highlight {
    color: #4ade80;
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #e2e8f0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background-color: #22c55e;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.8rem 1.6rem;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-primary-btn:hover {
    background-color: #16a34a;
    box-shadow: 0 6px 22px rgba(34, 197, 94, 0.5);
  }

  .hero-secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.8rem 1.45rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Interactive Route Finder Widget (Bespoke Hero Feature) */
  .hero-interactive-card {
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 24px;
    padding: 1.85rem 1.75rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  }

  .widget-header {
    margin-bottom: 1.25rem;
  }

  .widget-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #86efac;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .widget-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
  }

  .widget-sub {
    font-size: 0.8rem;
    color: #cbd5e1;
    margin-top: 0.2rem;
  }

  .route-tabs-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .route-tab-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e2e8f0;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .route-tab-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .route-tab-btn.active {
    background: #15803d;
    border-color: #4ade80;
    color: #ffffff;
    font-weight: 700;
  }

  .widget-preview-panel {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .preview-price-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .preview-price-label {
    font-size: 0.72rem;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .preview-price-val {
    font-size: 1.65rem;
    font-weight: 800;
    color: #4ade80;
    line-height: 1;
    margin-top: 0.2rem;
  }

  .preview-cap-badge {
    background: rgba(74, 222, 128, 0.15);
    color: #86efac;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
  }

  .preview-specs-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .p-spec-item {
    font-size: 0.78rem;
    color: #cbd5e1;
    display: flex;
    gap: 0.4rem;
  }

  .p-spec-label {
    color: #94a3b8;
    min-width: 85px;
  }

  .preview-desc-text {
    font-size: 0.8rem;
    color: #e2e8f0;
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .widget-book-btn {
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    width: 100%;
  }

  .widget-trust-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #94a3b8;
    padding-top: 0.25rem;
  }

  /* Trust Bar */
  .trust-bar {
    position: relative;
    z-index: 2;
    background: rgba(15, 23, 42, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.25rem 0;
  }

  .trust-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.25s var(--ease-luxury);
  }

  .trust-icon {
    color: #4ade80;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
  }

  .trust-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .trust-sub {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.2;
  }

  @media (max-width: 1024px) {
    .hero-main-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .trust-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .hero-container {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .hero-badge-wrap {
      margin-bottom: 1rem;
    }
    .hero-official-badge {
      font-size: 0.68rem;
      padding: 0.35rem 0.75rem;
    }
    .hero-title {
      font-size: 1.85rem;
      line-height: 1.22;
      margin-bottom: 0.85rem;
    }
    .hero-desc {
