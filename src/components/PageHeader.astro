---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  breadcrumbs: { label: string; href?: string; i18nKey?: string }[];
  titleI18nKey?: string;
  subtitleI18nKey?: string;
  badgeI18nKey?: string;
}

const { title, subtitle, badge, breadcrumbs, titleI18nKey, subtitleI18nKey, badgeI18nKey } = Astro.props;
---

<section class="page-header-section">
  <div class="header-overlay"></div>
  <div class="container page-header-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        {breadcrumbs.map((crumb, idx) => (
          <li class="breadcrumb-item">
            {crumb.href ? (
              <a href={crumb.href} class="breadcrumb-link" data-i18n={crumb.i18nKey}>{crumb.label}</a>
            ) : (
              <span class="breadcrumb-current" aria-current="page" data-i18n={crumb.i18nKey}>{crumb.label}</span>
            )}
            {idx < breadcrumbs.length - 1 && (
              <span class="breadcrumb-sep">/</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {badge && (
      <div class="page-badge" data-i18n={badgeI18nKey}>{badge}</div>
    )}

    <h1 class="page-header-title" data-i18n={titleI18nKey}>{title}</h1>
    {subtitle && (
      <p class="page-header-subtitle" data-i18n={subtitleI18nKey}>{subtitle}</p>
    )}
  </div>
</section>

<style>
  .page-header-section {
    position: relative;
    background: linear-gradient(135deg, #0f291e 0%, #173d2a 50%, #10261b 100%);
    padding: 3.5rem 0 3.75rem;
    color: #ffffff;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 20%, rgba(34, 197, 94, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  .page-header-container {
    position: relative;
    z-index: 2;
  }

  .breadcrumb-nav {
    margin-bottom: 1rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .breadcrumb-link {
    color: #cbd5e1;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #4ade80;
  }

  .breadcrumb-current {
    color: #86efac;
    font-weight: 600;
  }

  .breadcrumb-sep {
    color: #64748b;
  }

  .page-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #86efac;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
    background: rgba(22, 101, 52, 0.5);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(134, 239, 172, 0.3);
  }

  .page-header-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 0.65rem;
  }

  .page-header-subtitle {
    font-size: 1rem;
    color: #cbd5e1;
    max-width: 650px;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .page-header-section {
      padding: 2.5rem 0 2.75rem;
    }
    .page-header-title {
      font-size: 1.75rem;
    }
    .page-header-subtitle {
      font-size: 0.9rem;
    }
  }
</style>
