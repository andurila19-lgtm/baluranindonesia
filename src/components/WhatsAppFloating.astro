---
import { siteConfig } from '../data/baluranData';
---

<aside class="wa-float-container" aria-label="Bantuan WhatsApp Cepat">
  <a 
    href={siteConfig.whatsappUrl('Halo Baluran Indonesia, saya ingin tanya ketersediaan Jeep Safari.')} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="wa-float-btn"
    aria-label={`Chat WhatsApp dengan ${siteConfig.name}`}
  >
    <div class="wa-icon-pulse"></div>
    <svg viewBox="0 0 24 24" width="28" height="28" fill="#ffffff" class="wa-svg">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
    </svg>
    <div class="wa-tooltip">
      <span class="tooltip-title">Tanya Jeep Baluran</span>
      <span class="tooltip-sub">Online & Fast Response</span>
    </div>
  </a>
</aside>

<style>
  .wa-float-container {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 90;
  }

  .wa-float-btn {
    position: relative;
    width: 58px;
    height: 58px;
    background-color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .wa-float-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.55);
  }

  .wa-icon-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #25d366;
    opacity: 0.8;
    animation: pulse 2.5s infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 0.8;
      inset: -2px;
    }
    70% {
      opacity: 0;
      inset: -10px;
    }
    100% {
      opacity: 0;
      inset: -10px;
    }
  }

  .wa-svg {
    position: relative;
    z-index: 2;
  }

  .wa-tooltip {
    position: absolute;
    right: 68px;
    top: 50%;
    transform: translateY(-50%);
    background: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 0.45rem 0.85rem;
    border-radius: 10px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    transform: translateY(-50%) translateX(6px);
  }

  .wa-float-btn:hover .wa-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .tooltip-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
  }

  .tooltip-sub {
    font-size: 0.68rem;
    color: #16a34a;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .wa-float-container {
      bottom: 1.15rem;
      right: 1.15rem;
      z-index: 80;
    }
    .wa-float-btn {
      width: 48px;
      height: 48px;
      box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
    }
    .wa-svg {
      width: 24px;
      height: 24px;
    }
    .wa-tooltip {
      display: none;
    }
    .wa-icon-pulse {
      display: none;
    }
  }
</style>
