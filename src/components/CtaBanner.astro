---
import { siteConfig } from '../data/baluranData';
---

<section class="cta-banner-section" id="booking">
  <div class="cta-bg-wrapper">
    <img 
      src="/images/cta-sunset.webp" 
      alt="Siluet Jeep Safari dan Wisatawan Menjelajahi Baluran saat Senja" 
      class="cta-bg-img" 
      loading="lazy"
    />
    <div class="cta-overlay"></div>
  </div>

  <div class="container cta-container">
    <div class="cta-text">
      <h2 class="cta-title" data-i18n="section.cta_title">Siap Menjelajahi Baluran?</h2>
      <p class="cta-desc" data-i18n="section.cta_desc">
        Booking sekarang melalui WhatsApp dan dapatkan pengalaman Jeep Safari yang tak terlupakan.
      </p>
    </div>

    <div class="cta-action">
      <a 
        href={siteConfig.whatsappUrl('Halo Baluran Indonesia, saya ingin booking Jeep Safari Baluran.')} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-wa cta-btn"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
        </svg>
        <div class="cta-btn-text">
          <span data-i18n="common.book_wa">Booking via WhatsApp</span>
          <span class="cta-phone">{siteConfig.whatsappFormatted}</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner-section {
    position: relative;
    padding: 3.75rem 0;
    overflow: hidden;
    color: #ffffff;
  }

  .cta-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(15, 23, 42, 0.88) 0%,
      rgba(15, 23, 42, 0.75) 60%,
      rgba(15, 23, 42, 0.6) 100%
    );
  }

  .cta-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta-text {
    max-width: 600px;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .cta-btn {
    padding: 0.85rem 1.6rem;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .cta-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.15;
  }

  .cta-phone {
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.92;
  }

  @media (max-width: 820px) {
    .cta-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
