              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span id="modalPickup">Area Banyuwangi Kota</span>
          </div>
        </div>

        <p class="modal-desc" id="modalDesc"></p>

        <!-- Highlights -->
        <div class="modal-section-block">
          <h4 class="modal-subheading" id="modalHlHeading">Destinasi & Highlight Trip</h4>
          <ul class="modal-check-list" id="modalHighlights"></ul>
        </div>

        <!-- Inclusions & Exclusions -->
        <div class="modal-cols-block">
          <div class="modal-col">
            <h4 class="modal-subheading text-green" id="modalIncHeading">Fasilitas Termasuk</h4>
            <ul class="modal-check-list green-checks" id="modalIncluded"></ul>
          </div>
          <div class="modal-col">
            <h4 class="modal-subheading text-brown" id="modalExcHeading">Tidak Termasuk</h4>
