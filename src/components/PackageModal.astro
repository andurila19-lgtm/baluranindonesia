</div>

<script define:vars={{ modalItems, siteConfig }}>
  const modal = document.getElementById('packageModal');
  const closeBtn = document.getElementById('modalCloseBtn');
  const openButtons = document.querySelectorAll('.open-modal-btn, .open-dest-modal-btn');
  let currentActiveId = null;

  function getLang() {
    try {
      const saved = localStorage.getItem('baluran_lang');
      if (saved === 'en' || saved === 'id') return saved;
    } catch(e) {}
    return 'id';
  }

  function openPackageDetail(id) {
    const item = modalItems.find(i => i.id === id);
    if (!item) return;
    currentActiveId = id;

    const lang = getLang();
    const data = lang === 'en' ? item.en_data : item.id_data;

    // Headings localization
    const hlHeading = document.getElementById('modalHlHeading');
    if (hlHeading) hlHeading.textContent = lang === 'en' ? 'Tour Destinations & Highlights' : 'Destinasi & Highlight Trip';

    const incHeading = document.getElementById('modalIncHeading');
    if (incHeading) incHeading.textContent = lang === 'en' ? "What's Included" : 'Fasilitas Termasuk';

    const excHeading = document.getElementById('modalExcHeading');
    if (excHeading) excHeading.textContent = lang === 'en' ? 'Not Included' : 'Tidak Termasuk';

    const schHeading = document.getElementById('modalSchHeading');
    if (schHeading) schHeading.textContent = lang === 'en' ? 'Sample Tour Itinerary' : 'Contoh Jadwal Perjalanan (Itinerary)';

    const waBtnText = document.getElementById('modalWaBtnText');
    if (waBtnText) waBtnText.textContent = lang === 'en' ? 'Book This Tour via WhatsApp' : 'Booking Paket Ini via WhatsApp';

    // Fill data
    const imgEl = document.getElementById('modalImg');
    if (imgEl) imgEl.src = item.image;

    const badgeEl = document.getElementById('modalBadge');
    if (badgeEl) badgeEl.textContent = data.badge;

    const titleEl = document.getElementById('modalTitle');
    if (titleEl) titleEl.textContent = data.title;

    const priceEl = document.getElementById('modalPrice');
    if (priceEl) priceEl.textContent = item.priceFormatted;

    const unitEl = document.getElementById('modalUnit');
    if (unitEl) unitEl.textContent = item.unit;

    const durEl = document.getElementById('modalDuration');
    if (durEl) durEl.textContent = data.duration;

    const capEl = document.getElementById('modalCapacity');
    if (capEl) capEl.textContent = data.capacity;

    const pickEl = document.getElementById('modalPickup');
    if (pickEl) pickEl.textContent = data.pickup;

    const descEl = document.getElementById('modalDesc');
    if (descEl) descEl.textContent = data.description;

    // Highlights
    const hlList = document.getElementById('modalHighlights');
    if (hlList) {
      hlList.innerHTML = '';
      (data.highlights || []).forEach(hl => {
        const li = document.createElement('li');
        li.textContent = hl;
        hlList.appendChild(li);
      });
    }

    // Included
    const incList = document.getElementById('modalIncluded');
    if (incList) {
      incList.innerHTML = '';
      (data.included || []).forEach(inc => {
        const li = document.createElement('li');
        li.textContent = inc;
        incList.appendChild(li);
      });
    }

    // Not Included
    const notList = document.getElementById('modalNotIncluded');
    if (notList) {
      notList.innerHTML = '';
      (data.notIncluded || []).forEach(not => {
        const li = document.createElement('li');
        li.textContent = not;
        notList.appendChild(li);
      });
    }

    // Schedule timeline
    const timelineEl = document.getElementById('modalTimeline');
    if (timelineEl) {
      timelineEl.innerHTML = '';
      (data.schedule || []).forEach(sch => {
        const div = document.createElement('div');
        div.className = 'timeline-item';
        div.textContent = sch;
        timelineEl.appendChild(div);
      });
    }

    // WhatsApp CTA button link
    const waBtn = document.getElementById('modalWaBtn');
    if (waBtn) {
      const waMsg = lang === 'en' 
        ? `Hello Baluran Indonesia, I would like to book the ${data.title} (${item.priceFormatted}). Please check date availability.`
        : item.msg;
      waBtn.href = siteConfig.whatsappUrl(waMsg);
    }

    // Open modal & lock scroll
    if (modal) {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      currentActiveId = null;
    }
  }

  // Event Listeners for Opening
  openButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.getAttribute('data-detail-id') || btn.getAttribute('data-dest-id');
      if (id) openPackageDetail(id);
    });
  });

  // Close handlers
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Escape key close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
      closeModal();
    }
  });

  // Re-render modal if user toggles language while modal is open
  window.addEventListener('languageChanged', () => {
    if (currentActiveId && modal && modal.classList.contains('open')) {
      openPackageDetail(currentActiveId);
    }
  });
</script>

