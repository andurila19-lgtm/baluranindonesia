---

<div class="modal-backdrop" id="packageModal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-dialog">
    <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Tutup Detail">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-scroll-content">
      <div class="modal-media-header">
        <img id="modalImg" src="/images/paket-banyuwangi.webp" alt="Detail Paket" class="modal-cover-img" />
        <div class="modal-overlay-badge">
          <span class="badge-pill" id="modalBadge">Start Banyuwangi</span>
        </div>
      </div>

      <div class="modal-body-content">
        <h3 class="modal-title" id="modalTitle">Rute Baluran</h3>
        
        <div class="modal-price-box">
          <div class="modal-price-val" id="modalPrice">Rp750.000</div>
          <div class="modal-price-unit" id="modalUnit">/ Jeep</div>
        </div>

        <div class="modal-specs-strip">
          <div class="m-spec">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span id="modalDuration">5 Jam</span>
          </div>
          <div class="m-spec">
