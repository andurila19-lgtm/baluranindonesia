---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import PackageModal from '../../components/PackageModal.astro';
import { packagesData, siteConfig } from '../../data/baluranData';
---

<Layout 
  title="Daftar Paket Jeep Safari Baluran - Baluran Indonesia"
  description="Pilihan paket sewa Jeep Safari Taman Nasional Baluran: Start Banyuwangi Kota (Rp750.000) & Start Pintu Masuk Baluran (Rp650.000). Armada terawat, driver ramah."
>
  <Navbar />

  <PageHeader 
    title="Paket Jeep Safari Baluran"
    subtitle="Pilih titik keberangkatan yang paling sesuai dengan rencana liburan Anda di Banyuwangi & Situbondo."
    badge="PILIHAN LENGKAP JEEP SAFARI"
    titleI18nKey="page.packages.title"
    subtitleI18nKey="page.packages.subtitle"
    badgeI18nKey="page.packages.badge"
    breadcrumbs={[
      { label: 'Beranda', href: '/', i18nKey: 'nav.home' },
      { label: 'Paket Jeep Baluran', i18nKey: 'nav.packages' }
    ]}
  />

  <main class="section packages-page-content">
    <div class="container">
      <!-- Intro Notice -->
      <div class="packages-intro-box">
        <div class="intro-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="intro-text">
          <strong data-i18n="page.packages.intro_title">Semua Harga per Unit Jeep (Bukan per Orang)</strong>
          <p data-i18n="page.packages.intro_desc">Kapasitas 1 mobil Jeep dapat diisi hingga 5–6 orang penumpang. Biaya sudah termasuk bahan bakar dan driver lokal berpengalaman.</p>
        </div>
      </div>

      <!-- Packages Cards Detailed -->
      <div class="packages-list-grid">
        {packagesData.map((pkg) => (
          <article class="pkg-detail-card">
            <div class="pkg-media">
              <img src={pkg.image} alt={pkg.title} class="pkg-img" />
              <div class="pkg-badge-wrap">
                <span class="badge-pill bg-white-badge">{pkg.badge}</span>
              </div>
            </div>

            <div class="pkg-info">
              <div class="pkg-header">
                <h2 class="pkg-title">{pkg.title}</h2>
                <div class="pkg-price-tag">
                  <span class="price-num">{pkg.priceFormatted}</span>
                  <span class="price-label">{pkg.unit}</span>
                </div>
              </div>

              <!-- Quick Specs -->
              <div class="pkg-specs-row">
                <div class="spec-pill">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {pkg.duration}
                </div>
                <div class="spec-pill">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                  </svg>
                  {pkg.capacity}
                </div>
                <div class="spec-pill">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  {pkg.pickup}
                </div>
              </div>

              <p class="pkg-summary">{pkg.description}</p>

              <!-- Highlights list -->
              <div class="pkg-highlights-box">
                <div class="hl-title">Spot & Pengalaman Terbaik:</div>
                <ul class="hl-list">
                  {pkg.highlights.map(hl => (
                    <li>{hl}</li>
                  ))}
                </ul>
              </div>

              <!-- Action buttons -->
              <div class="pkg-actions-group">
                <a 
                  href={siteConfig.whatsappUrl(`Halo Baluran Indonesia, saya ingin reservasi ${pkg.title} (${pkg.priceFormatted}). Mohon cek ketersediaan armada.`)}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-wa pkg-book-btn"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16Z"/>
                  </svg>
                  Booking via WhatsApp
                </a>

                <a href={`/paket/${pkg.id}`} class="btn-outline pkg-page-link">
                  Halaman Detail & Itinerary
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Comparison Table -->
      <div class="comparison-section">
        <h3 class="comparison-title">Perbandingan Rute Baluran</h3>
        <p class="comparison-subtitle">Bandingkan rute untuk menentukan opsi yang paling pas dengan akomodasi dan jadwal Anda.</p>

        <div class="table-container">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Fitur & Layanan</th>
                <th>Start Banyuwangi Kota</th>
                <th>Start Pintu Masuk Baluran</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Harga Sewa</strong></td>
                <td><span class="table-price">Rp750.000 / Jeep</span></td>
                <td><span class="table-price">Rp650.000 / Jeep</span></td>
              </tr>
              <tr>
                <td><strong>Titik Penjemputan</strong></td>
                <td>Hotel/Bandara/Stasiun di Banyuwangi Kota</td>
                <td>Rest Area / Pintu Masuk Batangan Baluran</td>
              </tr>
              <tr>
                <td><strong>Durasi Total</strong></td>
                <td>5 Jam (Termasuk perjalanan dari kota)</td>
                <td>4 Jam (Fokus di dalam kawasan taman nasional)</td>
              </tr>
              <tr>
                <td><strong>Kapasitas</strong></td>
                <td>Maksimal 5–6 Orang</td>
                <td>Maksimal 5–6 Orang</td>
              </tr>
              <tr>
                <td><strong>Destinasi Utama</strong></td>
                <td>Savana Bekol, Pantai Bama, Mangrove Trail</td>
                <td>Savana Bekol, Pantai Bama, Hutan Evergreen</td>
              </tr>
              <tr>
                <td><strong>Kepraktisan</strong></td>
                <td>Sangat praktis tanpa perlu sewa mobil terpisah</td>
                <td>Cocok jika Anda sudah bawa kendaraan pribadi</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <PackageModal />
  <WhatsAppFloating />
</Layout>

<style>
  .packages-page-content {
    background-color: #fafbfc;
  }

  .packages-intro-box {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .intro-icon {
    color: #15803d;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .intro-text strong {
    font-size: 0.95rem;
    color: #166534;
    display: block;
    margin-bottom: 0.2rem;
  }

  .intro-text p {
    font-size: 0.85rem;
    color: #374151;
    margin: 0;
    line-height: 1.5;
  }

  .packages-list-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .pkg-detail-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #eef2f0;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: grid;
    grid-template-columns: 420px 1fr;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pkg-detail-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
  }

  .pkg-media {
    position: relative;
    min-height: 280px;
    background: #1e293b;
  }

  .pkg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pkg-badge-wrap {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
  }

  .bg-white-badge {
    background: #ffffff;
    color: #15803d;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    font-weight: 700;
  }

  .pkg-info {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pkg-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .pkg-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.25;
  }

  .pkg-price-tag {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .price-num {
    font-size: 1.65rem;
    font-weight: 800;
    color: #15803d;
  }

  .price-label {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .pkg-specs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #f3f4f6;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #4b5563;
  }

  .spec-pill svg {
    color: #15803d;
  }

  .pkg-summary {
    font-size: 0.92rem;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .pkg-highlights-box {
    background: #fafbfc;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    border: 1px solid #f0f3f2;
  }

  .hl-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .hl-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem 1rem;
  }

  .hl-list li {
    font-size: 0.8rem;
    color: #374151;
    position: relative;
    padding-left: 1rem;
  }

  .hl-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #16a34a;
    font-weight: bold;
  }

  .pkg-actions-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .pkg-book-btn {
    padding: 0.7rem 1.35rem;
    font-size: 0.88rem;
  }

  .pkg-page-link {
    padding: 0.7rem 1.25rem;
    font-size: 0.88rem;
  }

  /* Comparison */
  .comparison-section {
    background: #ffffff;
    border: 1px solid #eef2f0;
    border-radius: 20px;
    padding: 2.5rem 2.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .comparison-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 0.35rem;
  }

  .comparison-subtitle {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 1.75rem;
  }

  .table-container {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.88rem;
  }

  .comparison-table th {
    background: #f8faf9;
    padding: 1rem 1.25rem;
    font-weight: 700;
    color: #111827;
    border-bottom: 2px solid #e5e7eb;
  }

  .comparison-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #f3f4f6;
    color: #4b5563;
  }

  .table-price {
    font-weight: 800;
    color: #15803d;
    font-size: 1.05rem;
  }

  @media (max-width: 960px) {
    .pkg-detail-card {
      grid-template-columns: 1fr;
    }
    .pkg-media {
      height: 240px;
    }
  }

  @media (max-width: 600px) {
    .hl-list {
      grid-template-columns: 1fr;
    }
    .pkg-info {
      padding: 1.5rem;
    }
    .pkg-actions-group {
      flex-direction: column;
    }
    .pkg-book-btn, .pkg-page-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
