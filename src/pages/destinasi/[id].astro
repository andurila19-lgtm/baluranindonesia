---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { otherDestinationsData, siteConfig, type DestinationItem } from '../../data/baluranData';

export function getStaticPaths() {
  return otherDestinationsData.map((dest) => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

interface Props {
  dest: DestinationItem;
}

const { dest } = Astro.props;
---

<Layout 
  title={`${dest.title} - Sewa Jeep Wisata Banyuwangi | Baluran Indonesia`}
  description={`${dest.description} Durasi ${dest.duration}, kapasitas ${dest.capacity}, tarif ${dest.priceFormatted}/Jeep.`}
  image={dest.image}
>
  <Navbar />

  <PageHeader 
    title={dest.title}
    subtitle={dest.description}
    badge="DESTINASI FAVORIT BANYUWANGI"
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: 'Destinasi Lainnya', href: '/destinasi' },
      { label: dest.title }
    ]}
  />

  <main class="section dest-single-content">
    <div class="container">
      <div class="dest-layout">
        <div class="dest-main">
          <div class="dest-hero-box">
            <img src={dest.image} alt={dest.title} class="dest-img" />
          </div>

          <div class="dest-section-card">
            <h2 class="card-title">Daya Tarik & Spot Menarik</h2>
            <div class="dest-highlights-grid">
              {dest.highlights.map((hl) => (
                <div class="dest-hl-item">
                  <div class="hl-check">
                    <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="4 10 8 14 16 6"></polyline>
                    </svg>
                  </div>
                  <div class="hl-name">{hl}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="dest-section-card">
            <h2 class="card-title">Tentang Rute Ini</h2>
            <p class="dest-text">{dest.description}</p>
            <p class="dest-text">
              Armada Jeep kami siap menjemput Anda di hotel atau titik kumpul di area Banyuwangi Kota. Didampingi oleh driver lokal yang berpengalaman di medan perbukitan dan mengetahui titik fotografi terbaik agar liburan Anda semakin berkesan.
            </p>
          </div>

          <div class="dest-section-card">
            <h2 class="card-title">Fasilitas Termasuk</h2>
            <ul class="dest-inc-list">
              <li>Mobil Jeep 4x4 Terawat</li>
              <li>Driver lokal berpengalaman</li>
              <li>Bahan Bakar Minyak (BBM) selama perjalanan</li>
              <li>Penjemputan area Banyuwangi Kota (Hotel, Stasiun, Bandara)</li>
            </ul>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="dest-sidebar">
          <div class="dest-booking-box">
            <div class="d-head">
              <span class="d-sub">Tarif Sewa Jeep</span>
              <div class="d-price">{dest.priceFormatted} <span class="d-unit">{dest.unit}</span></div>
            </div>

            <div class="d-specs">
              <div class="d-row">
                <span>Durasi Trip</span>
                <strong>{dest.duration}</strong>
              </div>
              <div class="d-row">
                <span>Kapasitas</span>
                <strong>{dest.capacity}</strong>
              </div>
              <div class="d-row">
                <span>Penjemputan</span>
                <strong>Banyuwangi Kota</strong>
              </div>
            </div>

            <a 
              href={siteConfig.whatsappUrl(`Halo Baluran Indonesia, saya tertarik memesan ${dest.title} seharga ${dest.priceFormatted}. Mohon info ketersediaan armada.`)}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-wa full-width d-btn"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.56 14.39C16.31 14.27 15.09 13.67 14.86 13.59C14.64 13.5 14.47 13.46 14.31 13.71C14.14 13.96 13.66 14.52 13.51 14.69C13.37 14.85 13.22 14.87 12.97 14.75C12.72 14.63 11.92 14.36 10.97 13.52C10.23 12.86 9.73 12.05 9.58 11.8C9.44 11.55 9.56 11.42 9.69 11.29C9.8 11.18 9.94 11 10.06 10.86C10.19 10.72 10.23 10.62 10.31 10.45C10.39 10.28 10.35 10.14 10.29 10.02C10.23 9.9 9.73 8.68 9.53 8.17C9.33 7.68 9.12 7.74 8.97 7.74H8.49C8.32 7.74 8.05 7.8 7.82 8.05C7.59 8.3 6.94 8.91 6.94 10.16C6.94 11.41 7.85 12.61 7.98 12.78C8.11 12.95 9.77 15.51 12.3 16.6C12.91 16.86 13.37 17.02 13.75 17.14C14.36 17.33 14.92 17.3 15.36 17.24C15.86 17.16 16.88 16.61 17.09 16.03C17.3 15.44 17.3 14.94 17.24 14.84C17.18 14.73 17.01 14.67 16.76 14.54L16.56 14.39Z"/>
              </svg>
              Booking via WhatsApp
            </a>

            <a href="/destinasi" class="btn-outline full-width text-center" style="margin-top: 0.75rem;">
              Lihat Semua Destinasi
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
  <WhatsAppFloating />
</Layout>

<style>
  .dest-single-content {
    background-color: #fafbfc;
  }

  .dest-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .dest-hero-box {
    border-radius: 20px;
    overflow: hidden;
    height: 380px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .dest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dest-section-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #eef2f0;
    padding: 2rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 1.25rem;
  }

  .dest-highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  .dest-hl-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #f8faf9;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1f2937;
  }

  .hl-check {
    color: #15803d;
  }

  .dest-text {
    font-size: 0.92rem;
    line-height: 1.7;
    color: #4b5563;
    margin-bottom: 1rem;
  }

  .dest-text:last-child {
    margin-bottom: 0;
  }

  .dest-inc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .dest-inc-list li {
    font-size: 0.88rem;
    color: #374151;
    position: relative;
    padding-left: 1.25rem;
  }

  .dest-inc-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #15803d;
    font-weight: bold;
  }

  /* Sidebar */
  .dest-sidebar {
    position: sticky;
    top: 96px;
  }

  .dest-booking-box {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #eef2f0;
    padding: 1.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .d-head {
    border-bottom: 1px solid #f3f4f6;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .d-sub {
    font-size: 0.78rem;
    color: #6b7280;
    text-transform: uppercase;
    font-weight: 600;
  }

  .d-price {
    font-size: 1.85rem;
    font-weight: 800;
    color: #15803d;
    margin-top: 0.2rem;
  }

  .d-unit {
    font-size: 0.9rem;
    color: #6b7280;
    font-weight: 500;
  }

  .d-specs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .d-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .d-row strong {
    color: #111827;
  }

  .d-btn {
    padding: 0.85rem 1rem;
    font-size: 0.92rem;
  }

  .text-center {
    text-align: center;
  }

  @media (max-width: 900px) {
    .dest-layout {
      grid-template-columns: 1fr;
    }
    .dest-sidebar {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .dest-highlights-grid {
      grid-template-columns: 1fr;
    }
    .dest-hero-box {
      height: 240px;
    }
  }
</style>
