---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { otherDestinationsData, siteConfig } from '../../data/baluranData';
---

<Layout 
  title="Destinasi Wisata Populer Banyuwangi - Baluran Indonesia"
  description="Layanan sewa Jeep untuk rute destinasi populer sekitar Banyuwangi: Kawah Wurung Bondowoso (Rp900.000) dan Hutan De Djawatan Benculuk (Rp700.000)."
>
  <Navbar />

  <PageHeader 
    title="Destinasi Lainnya di Sekitar Banyuwangi"
    subtitle="Selain Taman Nasional Baluran, kami juga siap mengantar Anda menjelajahi keindahan lanskap alam spektakuler di sekitar Banyuwangi dan Bondowoso."
    badge="EKSPLORASI SEKITAR BANYUWANGI"
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: 'Destinasi Lainnya' }
    ]}
  />

  <main class="section dest-page-section">
    <div class="container">
      <div class="dest-cards-stack">
        {otherDestinationsData.map((dest) => (
          <article class="dest-feature-card">
            <div class="dest-f-img-wrap">
              <img src={dest.image} alt={dest.title} class="dest-f-img" />
              <div class="dest-f-tag">{dest.duration} | {dest.capacity}</div>
            </div>

            <div class="dest-f-info">
              <div class="dest-f-header">
                <div>
                  <h2 class="dest-f-title">{dest.title}</h2>
                  <div class="dest-f-pricing">
                    <span class="price-val">{dest.priceFormatted}</span>
                    <span class="price-unit">{dest.unit}</span>
                  </div>
                </div>
              </div>

              <p class="dest-f-desc">{dest.description}</p>

              <div class="dest-f-highlights">
                <span class="hl-tag-title">Daya Tarik Utama:</span>
                <div class="hl-pills-wrap">
                  {dest.highlights.map(hl => (
                    <span class="hl-pill">{hl}</span>
                  ))}
                </div>
              </div>

              <div class="dest-f-actions">
                <a 
                  href={siteConfig.whatsappUrl(`Halo Baluran Indonesia, saya tertarik dengan ${dest.title} seharga ${dest.priceFormatted}. Mohon informasi jadwal.`)}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-wa"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16Z"/>
                  </svg>
                  Booking via WhatsApp
                </a>

                <a href={`/destinasi/${dest.id}`} class="btn-outline">
                  Detail & Spot Foto
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
  <WhatsAppFloating />
</Layout>

<style>
  .dest-page-section {
    background-color: #fafbfc;
  }

  .dest-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .dest-feature-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #eef2f0;
    overflow: hidden;
    display: grid;
    grid-template-columns: 440px 1fr;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .dest-feature-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .dest-f-img-wrap {
    position: relative;
    min-height: 300px;
  }

  .dest-f-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dest-f-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }

  .dest-f-info {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .dest-f-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 0.35rem;
  }

  .dest-f-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .dest-f-desc {
    font-size: 0.92rem;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .dest-f-highlights {
    margin-bottom: 1.5rem;
  }

  .hl-tag-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #111827;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .hl-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hl-pill {
    background: #ecfdf5;
    color: #15803d;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    border: 1px solid #a7f3d0;
  }

  .dest-f-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .dest-feature-card {
      grid-template-columns: 1fr;
    }
    .dest-f-img-wrap {
      height: 250px;
    }
    .dest-f-info {
      padding: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .dest-f-actions {
      flex-direction: column;
    }
    .dest-f-actions a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
