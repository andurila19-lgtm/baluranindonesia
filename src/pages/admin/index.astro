---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Login Operator - Baluran Indonesia"
  description="Gerbang akses aman manajemen operasional dan visual site builder Baluran Indonesia."
>
  <main class="login-wrapper" id="login-app">
    <!-- Immediate Redirect Guard if already logged in -->
    <script is:inline>
      try {
        const raw = sessionStorage.getItem('baluran_admin_auth');
        if (raw) {
          const auth = JSON.parse(raw);
          if (auth && auth.expiresAt && auth.expiresAt > Date.now()) {
            window.location.replace('/admin/dashboard');
          }
        }
      } catch (e) {}
    </script>

    <div class="login-card">
      <div class="brand-badge">
        <span class="shield-icon">🛡️</span>
        <span>PORTAL OPERATOR RESMI</span>
      </div>

      <div class="brand-header">
        <div class="logo-mark">🚙</div>
        <h1 class="login-title">Baluran Indonesia</h1>
        <p class="login-subtitle">Masuk untuk mengelola susunan halaman dan katalog website.</p>
      </div>

      <!-- Alert Error Box -->
      <div class="alert-box" id="login-alert" style="display: none;" role="alert">
        <span class="alert-icon">⚠️</span>
        <span id="login-alert-msg">Username atau password salah.</span>
      </div>

      <form id="login-form" autocomplete="off">
        <!-- Anti-Bot Honeypot Trap -->
        <input 
          type="text" 
          name="website_url_trap" 
          id="website_url_trap" 
          style="display:none !important; position:absolute; left:-9999px; width:0; height:0;" 
          tabindex="-1" 
          autocomplete="off" 
        />

        <div class="form-group">
          <label for="username">Email Operator</label>
          <div class="input-wrap">
            <span class="input-icon">👤</span>
            <input 
              type="email" 
              id="username" 
              name="username" 
              placeholder="Masukkan email operator" 
              required 
              autocomplete="email"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="Masukkan password" 
              required 
              autocomplete="current-password"
            />
            <button type="button" class="btn-toggle-pw" id="toggle-pw" title="Tampilkan password" aria-label="Tampilkan password">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn-login" id="btn-submit-login">
          <span class="btn-text">Masuk ke Visual Site Builder</span>
          <div class="spinner" id="login-spinner" style="display: none;"></div>
        </button>
      </form>

      <div class="security-footer">
        <div class="sec-item"><span class="dot"></span> Otentikasi Supabase Cloud & JWT</div>
        <div class="sec-item"><span class="dot"></span> Perlindungan Anti-Brute Force</div>
        <div class="sec-item"><span class="dot"></span> Sesi Terisolasi & Aman</div>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --login-bg: #060d0b;
    --login-card-bg: #0c1714;
    --login-border: rgba(16, 185, 129, 0.2);
    --login-border-subtle: rgba(255, 255, 255, 0.08);
    --login-accent: #10b981;
    --login-accent-hover: #059669;
    --login-text: #f3f4f6;
    --login-text-muted: #9ca3af;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: radial-gradient(circle at 50% 25%, #0f2b22 0%, #060d0b 75%);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--login-text);
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    background: var(--login-card-bg);
    border: 1px solid var(--login-border);
    border-radius: 16px;
    padding: 2.25rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65);
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--login-accent);
    margin-bottom: 1.25rem;
  }

  .brand-header {
    margin-bottom: 1.75rem;
  }

  .logo-mark {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .login-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .login-subtitle {
    font-size: 0.875rem;
    color: var(--login-text-muted);
    line-height: 1.4;
  }

  .alert-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    color: #fca5a5;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.825rem;
    font-weight: 600;
    color: #d1d5db;
    margin-bottom: 0.5rem;
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    font-size: 1rem;
    pointer-events: none;
    color: #6b7280;
  }

  .input-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    background: #08120f;
    border: 1px solid var(--login-border-subtle);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .input-wrap input:focus {
    border-color: var(--login-accent);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .btn-toggle-pw {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.25rem;
    color: #6b7280;
  }

  .btn-login {
    width: 100%;
    padding: 0.9rem;
    background: var(--login-accent);
    border: none;
    border-radius: 8px;
    color: #06120e;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background 0.2s, transform 0.1s;
    margin-top: 0.5rem;
  }

  .btn-login:hover {
    background: var(--login-accent-hover);
  }

  .btn-login:active {
    transform: scale(0.99);
  }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(6, 18, 14, 0.3);
    border-top-color: #06120e;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .security-footer {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--login-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sec-item {
    font-size: 0.75rem;
    color: var(--login-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sec-item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--login-accent);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  // Check active Supabase session on load
  async function checkSession() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        sessionStorage.setItem('baluran_admin_auth', JSON.stringify({
          user: session.user.email,
          token: session.access_token,
          expiresAt: Date.now() + 8 * 60 * 60 * 1000
        }));
        window.location.replace('/admin/dashboard');
      }
    } catch (e) {
      console.warn('Gagal memverifikasi sesi Supabase:', e);
    }
  }
  checkSession();

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginAlert = document.getElementById('login-alert')!;
  const loginAlertMsg = document.getElementById('login-alert-msg')!;
  const btnSubmit = document.getElementById('btn-submit-login')!;
  const spinner = document.getElementById('login-spinner')!;
  const togglePwBtn = document.getElementById('toggle-pw')!;
  const pwInput = document.getElementById('password') as HTMLInputElement;
  const userInput = document.getElementById('username') as HTMLInputElement;

  togglePwBtn?.addEventListener('click', () => {
    pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginAlert.style.display = 'none';

    // Honeypot check
    const trap = (document.getElementById('website_url_trap') as HTMLInputElement).value;
    if (trap) {
      loginAlertMsg.textContent = 'Permintaan tidak diizinkan.';
      loginAlert.style.display = 'flex';
      return;
    }

    const emailVal = userInput.value.trim();
    if (!emailVal || !emailVal.includes('@')) {
      loginAlertMsg.textContent = 'Mohon masukkan format email yang valid.';
      loginAlert.style.display = 'flex';
      return;
    }

    const passwordVal = pwInput.value;

    btnSubmit.setAttribute('disabled', 'true');
    spinner.style.display = 'block';

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: emailVal,
        password: passwordVal,
      });

      if (error) {
        let msg = 'Email atau password salah.';
        if (error.message.includes('Invalid login credentials')) {
          msg = 'Email atau password salah. Pastikan akun sudah didaftarkan di Supabase.';
        } else if (error.message.includes('Email not confirmed')) {
          msg = 'Email belum dikonfirmasi di Supabase.';
        } else if (error.message) {
          msg = error.message;
        }
        loginAlertMsg.textContent = msg;
        loginAlert.style.display = 'flex';
        return;
      }

      if (data?.session) {
        sessionStorage.setItem('baluran_admin_auth', JSON.stringify({
          user: data.user.email,
          token: data.session.access_token,
          expiresAt: Date.now() + 8 * 60 * 60 * 1000
        }));
        window.location.replace('/admin/dashboard');
      }
    } catch (err: any) {
      loginAlertMsg.textContent = err?.message || 'Terjadi gangguan koneksi ke server auth.';
      loginAlert.style.display = 'flex';
    } finally {
      btnSubmit.removeAttribute('disabled');
      spinner.style.display = 'none';
    }
  });
</script>
