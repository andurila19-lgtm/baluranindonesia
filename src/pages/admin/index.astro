---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Portal Operator - Baluran Indonesia"
  description="Panel manajemen operasional dan pembaruan konten Baluran Indonesia."
>
  <main class="admin-wrapper" id="admin-app">
    <!-- 1. LOGIN SCREEN -->
    <div class="login-view" id="login-view">
      <div class="login-card">
        <div class="brand-badge">
          <span class="shield-icon">🛡️</span>
          <span>SECURE OPERATOR PORTAL</span>
        </div>
        <div class="brand-header">
          <div class="logo-mark">🚙</div>
          <h1 class="login-title">Baluran Indonesia</h1>
          <p class="login-subtitle">Sistem Manajemen Operasional & Pemesanan Jeep</p>
        </div>

        <!-- Alert Error Box -->
        <div class="alert-box" id="login-alert" style="display: none;">
          <span class="alert-icon">⚠️</span>
          <span id="login-alert-msg">Username atau password salah.</span>
        </div>

        <form id="login-form" autocomplete="off">
          <!-- Bot Honeypot Trap (Anti-Bot Automated Exploit) -->
          <input 
            type="text" 
            name="website_url_trap" 
            id="website_url_trap" 
            style="display:none !important; position:absolute; left:-9999px; width:0; height:0;" 
            tabindex="-1" 
            autocomplete="off" 
          />

          <div class="form-group">
            <label for="username">Username Operator</label>
            <div class="input-wrap">
              <span class="input-icon">👤</span>
              <input 
                type="text" 
                id="username" 
                name="username" 
                placeholder="Masukkan username" 
                required 
                autocomplete="username"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password Akses</label>
            <div class="input-wrap">
              <span class="input-icon">🔒</span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Masukkan password" 
                required 
                autocomplete="current-password"
              />
              <button type="button" class="btn-toggle-pw" id="toggle-pw" title="Lihat password">👁️</button>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btn-submit-login">
            <span class="btn-text">Masuk ke Dashboard Operator</span>
            <div class="spinner" id="login-spinner" style="display: none;"></div>
          </button>
        </form>

        <div class="security-footer">
          <div class="sec-item"><span class="dot"></span> Enkripsi TLS 1.3 / SHA-256 Validated</div>
          <div class="sec-item"><span class="dot"></span> Anti-Brute Force Protection Aktif</div>
          <div class="sec-item"><span class="dot"></span> Client-Side Honeypot & XSS Filter</div>
        </div>
      </div>
    </div>

    <!-- 2. DASHBOARD VIEW (AUTHENTICATED) -->
    <div class="dashboard-view" id="dashboard-view" style="display: none;">
      <!-- Dashboard Top Navbar -->
      <header class="dash-navbar">
        <div class="dash-brand">
          <div class="brand-icon-box">🚙</div>
          <div>
            <div class="dash-title">BALURAN INDONESIA</div>
            <div class="dash-status">
              <span class="status-indicator"></span> 
              <span>Operator Management System</span>
              <span class="env-pill">Live Production</span>
            </div>
          </div>
        </div>
        
        <div class="dash-user-actions">
          <a href="/" target="_blank" class="btn-view-site" title="Buka website publik">
            <span>🌐</span> Lihat Website
          </a>
          <div class="user-chip">
            <span class="user-avatar">👮</span>
            <span class="user-name">Operator: <strong>Admin</strong></span>
          </div>
          <button class="btn-logout" id="btn-logout">
            <span>🚪</span> Keluar
          </button>
        </div>
      </header>

      <!-- Dashboard Main Container -->
      <div class="dash-layout">
        <!-- Sidebar Navigation -->
        <aside class="dash-sidebar">
          <div class="sidebar-section-title">NAVIGASI MODUL</div>
          <nav class="dash-menu">
            <button class="menu-tab active" data-target="tab-packages">
              <span class="tab-icon">🚙</span> 
              <span class="tab-text">Paket Jeep Baluran</span>
              <span class="tab-badge" id="badge-pkg-count">2</span>
            </button>
            <button class="menu-tab" data-target="tab-contacts">
              <span class="tab-icon">⚙️</span> 
              <span class="tab-text">WhatsApp & Kontak</span>
            </button>
            <button class="menu-tab" data-target="tab-destinations">
              <span class="tab-icon">📍</span> 
              <span class="tab-text">Destinasi Sekitar</span>
              <span class="tab-badge" id="badge-dest-count">2</span>
            </button>
            <button class="menu-tab" data-target="tab-fleet">
              <span class="tab-icon">🛞</span> 
              <span class="tab-text">Armada Jeep</span>
              <span class="tab-badge" id="badge-fleet-count">5</span>
            </button>
            <button class="menu-tab" data-target="tab-faq">
              <span class="tab-icon">❓</span> 
              <span class="tab-text">Tanya Jawab (FAQ)</span>
            </button>
            <button class="menu-tab" data-target="tab-testimonials">
              <span class="tab-icon">💬</span> 
              <span class="tab-text">Testimoni Tamu</span>
            </button>
          </nav>

          <div class="sidebar-help-card">
            <div class="help-header">
              <span class="help-icon">💡</span>
              <h4>Panduan Operator</h4>
            </div>
            <p>Setiap perubahan yang Anda simpan akan langsung disinkronkan secara realtime ke database dan tercermin di website.</p>
            <div class="help-status-tag">● Cloud Database Sync Aktif</div>
          </div>
        </aside>

        <!-- Content Area -->
        <main class="dash-content">
          <!-- Quick Status Overview Banner -->
          <div class="dash-overview-bar">
            <div class="stat-card">
              <div class="stat-icon">🚙</div>
              <div class="stat-info">
                <span class="stat-label">Paket Aktif</span>
                <span class="stat-val" id="stat-pkg-val">2 Rute</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">📞</div>
              <div class="stat-info">
                <span class="stat-label">WhatsApp Booking</span>
                <span class="stat-val" id="stat-wa-val">085333050863</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">🛞</div>
              <div class="stat-info">
                <span class="stat-label">Armada Terdaftar</span>
                <span class="stat-val" id="stat-fleet-val">5 Unit</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">🛡️</div>
              <div class="stat-info">
                <span class="stat-label">Sistem Keamanan</span>
                <span class="stat-val text-green">Aman & Terlindungi</span>
              </div>
            </div>
          </div>

          <!-- TAB 1: PAKET JEEP -->
          <section class="tab-pane active" id="tab-packages">
            <div class="pane-header">
              <div>
                <h2>Kelola Paket Jeep Safari Baluran</h2>
                <p>Ubah harga sewa, durasi, kapasitas, dan rute perjalanan Jeep Safari secara langsung.</p>
              </div>
              <button class="btn-refresh" id="btn-refresh-packages" title="Muat ulang data">🔄 Refresh Data</button>
            </div>
            <div id="packages-container" class="cards-list">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat data paket dari server...</span>
              </div>
            </div>
          </section>

          <!-- TAB 2: WHATSAPP & KONTAK -->
          <section class="tab-pane" id="tab-contacts">
            <div class="pane-header">
              <div>
                <h2>Pengaturan Kontak & WhatsApp Booking</h2>
                <p>Nomor ini yang akan menerima pesan otomatis saat calon wisatawan menekan tombol booking di website.</p>
              </div>
            </div>
            <div id="contacts-container" class="cards-list">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat pengaturan kontak...</span>
              </div>
            </div>
          </section>

          <!-- TAB 3: DESTINASI -->
          <section class="tab-pane" id="tab-destinations">
            <div class="pane-header">
              <div>
                <h2>Kelola Destinasi Tambahan Sekitar</h2>
                <p>Paket rute gabungan sekitar Banyuwangi (Kawah Wurung, De Djawatan, dll).</p>
              </div>
            </div>
            <div id="destinations-container" class="cards-list">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat data destinasi...</span>
              </div>
            </div>
          </section>

          <!-- TAB 4: ARMADA JEEP -->
          <section class="tab-pane" id="tab-fleet">
            <div class="pane-header">
              <div>
                <h2>Galeri Armada Jeep Safari</h2>
                <p>Kelola daftar varian unit Jeep 4x4 yang ditampilkan kepada calon wisatawan.</p>
              </div>
            </div>
            <div id="fleet-container" class="cards-grid">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat data armada...</span>
              </div>
            </div>
          </section>

          <!-- TAB 5: FAQ -->
          <section class="tab-pane" id="tab-faq">
            <div class="pane-header">
              <div>
                <h2>Tanya Jawab Seputar Sewa Jeep (FAQ)</h2>
                <p>Perbarui pertanyaan dan jawaban yang sering diajukan pelanggan.</p>
              </div>
            </div>
            <div id="faq-container" class="cards-list">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat FAQ...</span>
              </div>
            </div>
          </section>

          <!-- TAB 6: TESTIMONI -->
          <section class="tab-pane" id="tab-testimonials">
            <div class="pane-header">
              <div>
                <h2>Ulasan & Testimoni Pelanggan</h2>
                <p>Ulasan wisatawan nyata yang ditampilkan di halaman beranda.</p>
              </div>
            </div>
            <div id="testimonials-container" class="cards-list">
              <div class="loading-state">
                <div class="pulse-loader"></div>
                <span>Memuat testimoni...</span>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toast-notif" style="display: none;">
      <span class="toast-icon">✅</span>
      <span class="toast-msg" id="toast-msg">Perubahan berhasil disimpan!</span>
    </div>
  </main>

  <script>
    // SHA-256 hash of "BaluranSuperAdmin#2026!"
    const TARGET_HASH = 'bac25350da094c9afabcd36d72ea7a85f87c0f82de039603950db27ce2c4c42e';
    const TARGET_USER = 'admin';

    // Backend endpoint
    const SANITY_PROJECT_ID = '7ox4kuc2';
    const SANITY_DATASET = 'production';
    const SANITY_TOKEN = 'skLaYJo6mRQU2kCkw5lavyXehPFy1uNlrOmoYaavfPZGbZ4QLHmkJr4FbSjPhfq4dacplttQfeW9nA2ZKOKP8kpd2cwQiVU5TuQwa3mIZYRV0nv2cODlowzUR7A5GlmrIPBNq8hg99QKUuEbESJprYw6gfUs6sHQoz9yQbfqU3kyXAMIA7Kb';

    // Helper SHA-256
    async function sha256(str: string): Promise<string> {
      const buf = new TextEncoder().encode(str);
      const hash = await crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(hash))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
    }

    // Rate Limiting (Anti-Brute Force)
    function checkRateLimit(): { allowed: boolean; retryAfter?: number } {
      const attempts = Number(localStorage.getItem('baluran_login_attempts') || '0');
      const lockedUntil = Number(localStorage.getItem('baluran_locked_until') || '0');
      const now = Date.now();

      if (lockedUntil > now) {
        return { allowed: false, retryAfter: Math.ceil((lockedUntil - now) / 1000) };
      }
      if (lockedUntil > 0 && lockedUntil <= now) {
        localStorage.removeItem('baluran_locked_until');
        localStorage.setItem('baluran_login_attempts', '0');
        return { allowed: true };
      }
      return { allowed: true };
    }

    function recordFailedAttempt(): { locked: boolean; retryAfter?: number } {
      let attempts = Number(localStorage.getItem('baluran_login_attempts') || '0') + 1;
      localStorage.setItem('baluran_login_attempts', attempts.toString());

      if (attempts >= 5) {
        const lockoutTime = Date.now() + 15 * 60 * 1000; // 15 menit
        localStorage.setItem('baluran_locked_until', lockoutTime.toString());
        return { locked: true, retryAfter: 900 };
      }
      return { locked: false };
    }

    function resetRateLimit() {
      localStorage.removeItem('baluran_login_attempts');
      localStorage.removeItem('baluran_locked_until');
    }

    let globalStore: any = {
      siteSettings: {},
      packages: [],
      destinations: [],
      fleet: [],
      testimonials: [],
      faqs: []
    };

    const loginView = document.getElementById('login-view')!;
    const dashboardView = document.getElementById('dashboard-view')!;
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginAlert = document.getElementById('login-alert')!;
    const loginAlertMsg = document.getElementById('login-alert-msg')!;
    const loginSpinner = document.getElementById('login-spinner')!;
    const btnSubmitLogin = document.getElementById('btn-submit-login')!;
    const btnLogout = document.getElementById('btn-logout')!;
    const toastNotif = document.getElementById('toast-notif')!;
    const toastMsg = document.getElementById('toast-msg')!;

    // Toggle password view
    document.getElementById('toggle-pw')?.addEventListener('click', () => {
      const pwInput = document.getElementById('password') as HTMLInputElement;
      pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
    });

    function showToast(msg: string, isError = false) {
      toastMsg.innerText = msg;
      const icon = toastNotif.querySelector('.toast-icon') as HTMLElement;
      if (icon) icon.innerText = isError ? '⚠️' : '✅';
      toastNotif.className = 'toast-notification ' + (isError ? 'toast-error' : 'toast-success');
      toastNotif.style.display = 'flex';
      setTimeout(() => {
        toastNotif.style.display = 'none';
      }, 4000);
    }

    // Tab Navigation
    document.querySelectorAll('.menu-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.menu-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        const target = (e.currentTarget as HTMLElement).getAttribute('data-target')!;
        (e.currentTarget as HTMLElement).classList.add('active');
        document.getElementById(target)?.classList.add('active');
      });
    });

    document.getElementById('btn-refresh-packages')?.addEventListener('click', () => {
      loadSanityData();
      showToast('Memperbarui data dari server...');
    });

    // Check Authentication
    function checkAuth() {
      const isAuth = sessionStorage.getItem('baluran_is_auth') === 'true';
      if (isAuth) {
        showDashboard();
        loadSanityData();
      } else {
        showLogin();
      }
    }

    function showLogin() {
      loginView.style.display = 'flex';
      dashboardView.style.display = 'none';
    }

    function showDashboard() {
      loginView.style.display = 'none';
      dashboardView.style.display = 'flex';
    }

    // Login Submission
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginAlert.style.display = 'none';

      // 1. Rate Limit Check
      const rateLimit = checkRateLimit();
      if (!rateLimit.allowed) {
        loginAlertMsg.innerText = `Terlalu banyak percobaan gagal. Akses dibekukan selama ${rateLimit.retryAfter} detik.`;
        loginAlert.style.display = 'flex';
        return;
      }

      // 2. Bot Trap Check
      const trap = (document.getElementById('website_url_trap') as HTMLInputElement).value;
      if (trap && trap.trim() !== '') {
        loginAlertMsg.innerText = 'Akses ditolak.';
        loginAlert.style.display = 'flex';
        return;
      }

      loginSpinner.style.display = 'inline-block';
      btnSubmitLogin.setAttribute('disabled', 'true');

      const username = (document.getElementById('username') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const inputHash = await sha256(password);

        if (username.toLowerCase() === TARGET_USER && inputHash === TARGET_HASH) {
          resetRateLimit();
          sessionStorage.setItem('baluran_is_auth', 'true');
          showDashboard();
          loadSanityData();
          showToast('Login berhasil. Selamat datang Operator Baluran!');
        } else {
          const attempt = recordFailedAttempt();
          loginAlertMsg.innerText = attempt.locked
            ? `Batas 5x percobaan terlampaui. Akses dibekukan selama ${attempt.retryAfter} detik.`
            : 'Username atau Password salah.';
          loginAlert.style.display = 'flex';
        }
      } catch (err) {
        loginAlertMsg.innerText = 'Terjadi kesalahan sistem keamanan.';
        loginAlert.style.display = 'flex';
      } finally {
        loginSpinner.style.display = 'none';
        btnSubmitLogin.removeAttribute('disabled');
      }
    });

    // Logout
    btnLogout.addEventListener('click', () => {
      sessionStorage.removeItem('baluran_is_auth');
      showLogin();
      showToast('Anda telah keluar.');
    });

    // Fetch Live Data
    async function loadSanityData() {
      try {
        const query = encodeURIComponent('*[_type in ["siteSettings", "tourPackage", "destination", "fleet", "testimonial", "faq"]]{ ..., "imageUrl": image.asset->url }');
        const url = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/query/${SANITY_DATASET}?query=${query}`;
        const res = await fetch(url);
        const json = await res.json();

        if (json.result) {
          const docs = json.result;
          globalStore.siteSettings = docs.find((d: any) => d._type === 'siteSettings') || {};
          globalStore.packages = docs.filter((d: any) => d._type === 'tourPackage').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.destinations = docs.filter((d: any) => d._type === 'destination').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.fleet = docs.filter((d: any) => d._type === 'fleet').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.testimonials = docs.filter((d: any) => d._type === 'testimonial');
          globalStore.faqs = docs.filter((d: any) => d._type === 'faq').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));

          // Update header badges
          const bPkg = document.getElementById('badge-pkg-count');
          if (bPkg) bPkg.innerText = globalStore.packages.length.toString();
          const bDest = document.getElementById('badge-dest-count');
          if (bDest) bDest.innerText = globalStore.destinations.length.toString();
          const bFleet = document.getElementById('badge-fleet-count');
          if (bFleet) bFleet.innerText = globalStore.fleet.length.toString();

          const statPkg = document.getElementById('stat-pkg-val');
          if (statPkg) statPkg.innerText = `${globalStore.packages.length} Rute`;
          const statWa = document.getElementById('stat-wa-val');
          if (statWa && globalStore.siteSettings.whatsapp) statWa.innerText = globalStore.siteSettings.whatsapp;
          const statFleet = document.getElementById('stat-fleet-val');
          if (statFleet) statFleet.innerText = `${globalStore.fleet.length} Unit`;

          renderAllData();
        }
      } catch (err) {
        console.error('Gagal memuat data:', err);
        showToast('Gagal memuat data dari cloud database.', true);
      }
    }

    // Save Generic Document
    async function saveDoc(docId: string, fields: Record<string, any>, btnElement: HTMLButtonElement) {
      const originalHTML = btnElement.innerHTML;
      btnElement.innerHTML = '<span class="spinner-sm"></span> Menyimpan...';
      btnElement.setAttribute('disabled', 'true');

      // Sanitasi input ketat (Anti-XSS & SQLi)
      const sanitized: Record<string, any> = {};
      for (const [k, v] of Object.entries(fields)) {
        if (typeof v === 'string') {
          sanitized[k] = v.replace(/[<>]/g, '').trim();
        } else {
          sanitized[k] = v;
        }
      }

      const mutations = [
        {
          patch: {
            id: docId,
            set: sanitized
          }
        }
      ];

      try {
        const url = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/mutate/${SANITY_DATASET}`;
        const res = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${SANITY_TOKEN}`
          },
          body: JSON.stringify({ mutations })
        });
        const data = await res.json();

        if (res.ok && data.results) {
          showToast('Data berhasil disimpan dan disinkronkan ke live website!');
        } else {
          showToast('Gagal menyimpan data.', true);
        }
      } catch (err) {
        showToast('Koneksi terputus saat menyimpan.', true);
      } finally {
        btnElement.innerHTML = originalHTML;
        btnElement.removeAttribute('disabled');
      }
    }

    // Upload & Attach Image to Sanity
    async function uploadAndAttachImage(file: File, docId: string, previewEl: HTMLImageElement, statusEl: HTMLElement) {
      if (!file) return;

      const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/avif'];
      if (!validTypes.includes(file.type)) {
        showToast('Format foto harus JPG, PNG, atau WEBP.', true);
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        showToast('Ukuran foto maksimal 10MB.', true);
        return;
      }

      previewEl.src = URL.createObjectURL(file);
      statusEl.style.display = 'flex';
      statusEl.className = 'upload-status status-uploading';
      statusEl.innerHTML = '<span class="spinner-sm"></span> <span>Mengunggah foto ke Sanity CDN...</span>';

      try {
        const filename = encodeURIComponent(file.name || 'image.webp');
        const uploadUrl = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/assets/images/${SANITY_DATASET}?filename=${filename}`;
        
        const res = await fetch(uploadUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${SANITY_TOKEN}`,
            'Content-Type': file.type
          },
          body: file
        });

        const data = await res.json();
        if (!res.ok || !data.document) {
          throw new Error(data.message || 'Gagal mengunggah foto ke cloud.');
        }

        const assetId = data.document._id;
        const cdnUrl = data.document.url;

        // Attach image to Sanity doc
        const patchUrl = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/mutate/${SANITY_DATASET}`;
        const patchRes = await fetch(patchUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${SANITY_TOKEN}`
          },
          body: JSON.stringify({
            mutations: [
              {
                patch: {
                  id: docId,
                  set: {
                    image: {
                      _type: 'image',
                      asset: {
                        _type: 'reference',
                        _ref: assetId
                      }
                    }
                  }
                }
              }
            ]
          })
        });

        if (!patchRes.ok) {
          throw new Error('Gagal menautkan asset foto ke dokumen.');
        }

        previewEl.src = cdnUrl;
        statusEl.className = 'upload-status status-success';
        statusEl.innerHTML = '<span>✅ Foto berhasil diperbarui di website!</span>';
