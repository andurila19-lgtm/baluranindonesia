    --adm-primary-hover: #059669;
    --adm-primary-glow: rgba(16, 185, 129, 0.25);
    --adm-text-main: #f8fafc;
    --adm-text-muted: #94a3b8;
    --adm-text-subtle: #64748b;
  }

  body {
    background-color: var(--adm-bg-main);
  }

  .admin-wrapper {
    min-height: 100vh;
    background: radial-gradient(circle at 15% 15%, #0d2f1f 0%, #06150e 70%);
    color: var(--adm-text-main);
    font-family: -apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', 'Inter', 'Segoe UI', Roboto, sans-serif;
  }

  /* ----------------------------------------------------
     1. LOGIN SCREEN
     ---------------------------------------------------- */
  .login-view {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: radial-gradient(circle at 50% 30%, #113824 0%, #05130c 100%);
  }

  .login-card {
    max-width: 440px;
    width: 100%;
    background: rgba(10, 31, 21, 0.85);
    border: 1px solid rgba(46, 204, 113, 0.25);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 24px;
    padding: 2.75rem 2.25rem;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7), 0 0 40px rgba(46, 204, 113, 0.08);
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(46, 204, 113, 0.12);
    border: 1px solid rgba(46, 204, 113, 0.3);
    color: #34d399;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .logo-mark {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
  }

  .login-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
  }

  .login-subtitle {
    color: #94a3b8;
    font-size: 0.875rem;
    margin: 0 0 2rem 0;
    line-height: 1.5;
  }

  .alert-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .form-group {
    margin-bottom: 1.35rem;
    text-align: left;
  }

  .form-group label {
    display: block;
    font-size: 0.825rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    font-size: 1.1rem;
    pointer-events: none;
    opacity: 0.7;
  }

  .input-wrap input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.85rem;
    background: rgba(4, 15, 10, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    color: #ffffff;
    font-size: 0.95rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-sizing: border-box;
  }

  .input-wrap input:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    background: rgba(4, 15, 10, 0.95);
  }

  .btn-toggle-pw {
    position: absolute;
    right: 0.85rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .btn-toggle-pw:hover {
    opacity: 1;
  }

  .btn-login {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
  }

  .btn-login:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
    filter: brightness(1.08);
  }

  .btn-login:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .security-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.775rem;
    color: #64748b;
  }

  .sec-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10b981;
  }

  /* ----------------------------------------------------
     2. DASHBOARD TOP NAVBAR
     ---------------------------------------------------- */
  .dash-navbar {
    background: rgba(6, 21, 14, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(46, 204, 113, 0.2);
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .dash-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .brand-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .dash-title {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .dash-status {
    font-size: 0.75rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.1rem;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
  }

  .env-pill {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.675rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-left: 0.35rem;
  }

  .dash-user-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .btn-view-site {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-view-site:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .user-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.825rem;
    color: #e2e8f0;
  }

  .btn-logout {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.825rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s;
  }

  .btn-logout:hover {
    background: #ef4444;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
  }

  /* ----------------------------------------------------
     3. DASHBOARD MAIN LAYOUT & SIDEBAR
     ---------------------------------------------------- */
  .dashboard-view {
    height: 100vh;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #06150e;
  }

  .dash-layout {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 260px 1fr;
    height: calc(100vh - 64px);
    overflow: hidden;
  }

  .dash-sidebar {
    background: #081d13;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0.95rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    overflow-y: auto;
    box-sizing: border-box;
    gap: 1.25rem;
  }

  .dash-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .dash-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .sidebar-section-title {
    font-size: 0.675rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #64748b;
    margin: 0.25rem 0 0.25rem 0.5rem;
  }

  .dash-menu {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .menu-tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 0.85rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #94a3b8;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .menu-tab .tab-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .menu-tab .tab-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-tab .tab-badge {
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    margin-left: auto;
  }

  .menu-tab:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    transform: translateX(2px);
  }

  .menu-tab.active {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.28);
    font-weight: 700;
    box-shadow: inset 3px 0 0 #10b981;
  }

  .menu-tab.active .tab-badge {
    background: rgba(16, 185, 129, 0.25);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .sidebar-help-card {
    margin-top: auto;
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.16);
    border-radius: 12px;
    padding: 1rem;
    font-size: 0.775rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .sidebar-help-card .help-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
  }

  .sidebar-help-card h4 {
    color: #e2e8f0;
    font-size: 0.85rem;
    font-weight: 700;
    margin: 0;
  }

  .help-status-tag {
    margin-top: 0.75rem;
    color: #34d399;
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ----------------------------------------------------
     4. CONTENT AREA & OVERVIEW STATS
     ---------------------------------------------------- */
  .dash-content {
    flex: 1;
    padding: 2rem 2.5rem 4rem 2.5rem;
    background: #071910;
    overflow-y: auto;
    height: 100%;
    box-sizing: border-box;
  }

  .dash-content::-webkit-scrollbar {
    width: 6px;
  }
  .dash-content::-webkit-scrollbar-track {
    background: #071910;
  }
  .dash-content::-webkit-scrollbar-thumb {
    background: rgba(46, 204, 113, 0.25);
    border-radius: 4px;
  }
  .dash-content::-webkit-scrollbar-thumb:hover {
    background: rgba(46, 204, 113, 0.45);
  }

  .dash-overview-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .stat-card {
    background: rgba(12, 36, 24, 0.7);
    border: 1px solid rgba(46, 204, 113, 0.16);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(46, 204, 113, 0.35);
  }

  .stat-icon {
    font-size: 2rem;
    background: rgba(16, 185, 129, 0.12);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 0.2rem;
  }

  .text-green {
    color: #34d399 !important;
    font-size: 0.95rem;
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
    animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .pane-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pane-header h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.01em;
  }

  .pane-header p {
    color: #94a3b8;
    margin: 0;
    font-size: 0.925rem;
  }

  .btn-refresh {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-refresh:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  /* ----------------------------------------------------
     5. PREMIUM EDIT CARDS & INPUT STYLING (GLOBAL)
     ---------------------------------------------------- */
  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 960px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1050px;
  }

  .edit-card {
    background: rgba(12, 34, 23, 0.8);
    border: 1px solid rgba(46, 204, 113, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .edit-card:hover {
    border-color: rgba(46, 204, 113, 0.35);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
  }

  .card-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-title-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .card-icon {
    font-size: 1.85rem;
    background: rgba(16, 185, 129, 0.12);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
  }

  .card-subtitle {
    font-size: 0.775rem;
    color: #94a3b8;
    display: block;
    margin-top: 0.2rem;
  }

  .header-pills {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .badge-price {
    background: rgba(16, 185, 129, 0.18);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34d399;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.825rem;
    font-weight: 800;
  }

  .badge-status {
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* FORMS & GRID */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.35rem 1.25rem;
  }

  .col-12 { grid-column: span 12; }
  .col-6 { grid-column: span 6; }
  .col-4 { grid-column: span 4; }

  .form-label {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.825rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .req-star {
    color: #ef4444;
  }

  .field-hint {
    display: block;
    color: #94a3b8;
    font-size: 0.75rem;
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .text-emerald {
    color: #34d399 !important;
  }

  /* INPUT & TEXTAREA CONTROLS (CRITICAL STYLING) */
  .form-control {
    width: 100% !important;
    padding: 0.85rem 1rem !important;
    background: #05160d !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    border-radius: 10px !important;
    color: #ffffff !important;
    font-size: 0.925rem !important;
    font-family: inherit !important;
    box-sizing: border-box !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .form-control:focus {
    outline: none !important;
    border-color: #10b981 !important;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25) !important;
    background: #04120b !important;
  }

  .form-control::placeholder {
    color: #64748b;
  }

  textarea.form-control {
    resize: vertical;
    min-height: 75px;
    line-height: 1.5;
  }

  .input-prefix-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-prefix {
    position: absolute;
    left: 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    pointer-events: none;
  }

  .form-control.with-prefix {
    padding-left: 2.85rem !important;
  }

  /* CARD FOOTER & SAVE BUTTON */
  .card-footer-action {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .action-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.775rem;
    color: #64748b;
  }

  .sync-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
  }

  .btn-save {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
    color: #ffffff !important;
    border: none !important;
    padding: 0.85rem 1.75rem !important;
    border-radius: 10px !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35) !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .btn-save:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 22px rgba(16, 185, 129, 0.45) !important;
    filter: brightness(1.08) !important;
  }

  .btn-save:disabled {
    opacity: 0.65 !important;
    cursor: not-allowed !important;
    transform: none !important;
  }

  /* FLEET ITEM CARD */
  .fleet-item-card {
    background: rgba(12, 34, 23, 0.8);
    border: 1px solid rgba(46, 204, 113, 0.2);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .fleet-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
