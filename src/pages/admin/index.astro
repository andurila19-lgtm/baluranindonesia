---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Portal Operator - Baluran Indonesia"
  description="Panel manajemen operasional dan pembaruan konten Baluran Indonesia."
>
  <main class="admin-wrapper" id="admin-app">
    <!-- 1. LOGIN SCREEN -->
    <div class="login-view" id="login-view">
      <div class="login-card">
        <div class="brand-badge">
          <span class="shield-icon">🛡️</span>
          <span>SECURE OPERATOR PORTAL</span>
        </div>
        <div class="brand-header">
          <div class="logo-mark">🚙</div>
          <h1 class="login-title">Baluran Indonesia</h1>
          <p class="login-subtitle">Sistem Manajemen Operasional & Pemesanan Jeep</p>
        </div>

        <!-- Alert Error Box -->
        <div class="alert-box" id="login-alert" style="display: none;">
          <span class="alert-icon">⚠️</span>
          <span id="login-alert-msg">Username atau password salah.</span>
        </div>

        <form id="login-form" autocomplete="off">
          <!-- Bot Honeypot Trap (Anti-Bot Automated Exploit) -->
          <input 
            type="text" 
            name="website_url_trap" 
            id="website_url_trap" 
            style="display:none !important; position:absolute; left:-9999px; width:0; height:0;" 
            tabindex="-1" 
            autocomplete="off" 
          />

          <div class="form-group">
            <label for="username">Username Operator</label>
            <div class="input-wrap">
              <span class="input-icon">👤</span>
              <input 
                type="text" 
                id="username" 
                name="username" 
                placeholder="Masukkan username" 
                required 
                autocomplete="username"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password Akses</label>
            <div class="input-wrap">
              <span class="input-icon">🔒</span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Masukkan password" 
                required 
                autocomplete="current-password"
              />
              <button type="button" class="btn-toggle-pw" id="toggle-pw" title="Lihat password">👁️</button>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btn-submit-login">
            <span class="btn-text">Masuk ke Dashboard Operator</span>
            <div class="spinner" id="login-spinner" style="display: none;"></div>
          </button>
        </form>

        <div class="security-footer">
          <div class="sec-item"><span class="dot"></span> Enkripsi TLS 1.3 / SHA-256 Validated</div>
          <div class="sec-item"><span class="dot"></span> Anti-Brute Force Protection Aktif</div>
          <div class="sec-item"><span class="dot"></span> Client-Side Honeypot & XSS Filter</div>
        </div>
      </div>
    </div>

    <!-- 2. DASHBOARD VIEW (AUTHENTICATED) -->
    <div class="dashboard-view" id="dashboard-view" style="display: none;">
      <!-- Dashboard Top Navbar -->
      <header class="dash-navbar">
        <div class="dash-brand">
          <span class="dash-logo">🚙</span>
          <div>
            <div class="dash-title">BALURAN INDONESIA</div>
            <div class="dash-status"><span class="status-indicator"></span> Operator Management System</div>
          </div>
        </div>
        <div class="dash-user-actions">
          <div class="user-chip">
            <span class="user-avatar">👮</span>
            <span class="user-name">Operator: <strong>Admin</strong></span>
          </div>
          <button class="btn-logout" id="btn-logout">
            <span>🚪</span> Keluar
          </button>
        </div>
      </header>

      <!-- Dashboard Main Container -->
      <div class="dash-layout">
        <!-- Sidebar Navigation -->
        <aside class="dash-sidebar">
          <nav class="dash-menu">
            <button class="menu-tab active" data-target="tab-packages">
              <span class="tab-icon">🚙</span> Paket Jeep Baluran
            </button>
            <button class="menu-tab" data-target="tab-contacts">
              <span class="tab-icon">⚙️</span> WhatsApp & Kontak
            </button>
            <button class="menu-tab" data-target="tab-destinations">
              <span class="tab-icon">📍</span> Destinasi Sekitar
            </button>
            <button class="menu-tab" data-target="tab-fleet">
              <span class="tab-icon">🛞</span> Armada Jeep
            </button>
            <button class="menu-tab" data-target="tab-faq">
              <span class="tab-icon">❓</span> Tanya Jawab (FAQ)
            </button>
            <button class="menu-tab" data-target="tab-testimonials">
              <span class="tab-icon">💬</span> Testimoni Tamu
            </button>
          </nav>

          <div class="sidebar-help-card">
            <h4>💡 Panduan Operator</h4>
            <p>Setiap perubahan yang Anda simpan akan langsung disinkronkan ke server secara aman tanpa mengganggu operasional website.</p>
          </div>
        </aside>

        <!-- Content Area -->
        <main class="dash-content">
          <!-- TAB 1: PAKET JEEP -->
          <section class="tab-pane active" id="tab-packages">
            <div class="pane-header">
              <div>
                <h2>Kelola Paket Jeep Safari Baluran</h2>
                <p>Ubah harga sewa, durasi, kapasitas, dan rute perjalanan Jeep.</p>
              </div>
            </div>
            <div id="packages-container" class="cards-list">
              <div class="loading-state">Memuat data paket...</div>
            </div>
          </section>

          <!-- TAB 2: WHATSAPP & KONTAK -->
          <section class="tab-pane" id="tab-contacts">
            <div class="pane-header">
              <div>
                <h2>Pengaturan Kontak & WhatsApp Booking</h2>
                <p>Nomor ini yang akan menerima chat otomatis saat calon wisatawan menekan tombol booking.</p>
              </div>
            </div>
            <div id="contacts-container" class="form-card">
              <div class="loading-state">Memuat pengaturan kontak...</div>
            </div>
          </section>

          <!-- TAB 3: DESTINASI -->
          <section class="tab-pane" id="tab-destinations">
            <div class="pane-header">
              <div>
                <h2>Kelola Destinasi Tambahan</h2>
                <p>Paket rute sekitar Banyuwangi (Kawah Wurung, De Djawatan, dll).</p>
              </div>
            </div>
            <div id="destinations-container" class="cards-list">
              <div class="loading-state">Memuat data destinasi...</div>
            </div>
          </section>

          <!-- TAB 4: ARMADA JEEP -->
          <section class="tab-pane" id="tab-fleet">
            <div class="pane-header">
              <div>
                <h2>Galeri Armada Jeep Safari</h2>
                <p>Kelola daftar varian unit Jeep yang ditampilkan kepada wisatawan.</p>
              </div>
            </div>
            <div id="fleet-container" class="cards-grid">
              <div class="loading-state">Memuat data armada...</div>
            </div>
          </section>

          <!-- TAB 5: FAQ -->
          <section class="tab-pane" id="tab-faq">
            <div class="pane-header">
              <div>
                <h2>Tanya Jawab Seputar Sewa Jeep (FAQ)</h2>
                <p>Perbarui pertanyaan yang paling sering ditanyakan pelanggan.</p>
              </div>
            </div>
            <div id="faq-container" class="cards-list">
              <div class="loading-state">Memuat FAQ...</div>
            </div>
          </section>

          <!-- TAB 6: TESTIMONI -->
          <section class="tab-pane" id="tab-testimonials">
            <div class="pane-header">
              <div>
                <h2>Ulasan & Testimoni Pelanggan</h2>
                <p>Testimoni wisatawan yang ditampilkan di halaman depan.</p>
              </div>
            </div>
            <div id="testimonials-container" class="cards-list">
              <div class="loading-state">Memuat testimoni...</div>
            </div>
          </section>
        </main>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toast-notif" style="display: none;">
      <span class="toast-icon">✅</span>
      <span class="toast-msg" id="toast-msg">Perubahan berhasil disimpan!</span>
    </div>
  </main>

  <script>
    // SHA-256 hash of "BaluranSuperAdmin#2026!"
    const TARGET_HASH = 'bac25350da094c9afabcd36d72ea7a85f87c0f82de039603950db27ce2c4c42e';
    const TARGET_USER = 'admin';

    // Backend endpoint
    const SANITY_PROJECT_ID = '7ox4kuc2';
    const SANITY_DATASET = 'production';
    const SANITY_TOKEN = 'skLaYJo6mRQU2kCkw5lavyXehPFy1uNlrOmoYaavfPZGbZ4QLHmkJr4FbSjPhfq4dacplttQfeW9nA2ZKOKP8kpd2cwQiVU5TuQwa3mIZYRV0nv2cODlowzUR7A5GlmrIPBNq8hg99QKUuEbESJprYw6gfUs6sHQoz9yQbfqU3kyXAMIA7Kb';

    // Helper SHA-256
    async function sha256(str: string): Promise<string> {
      const buf = new TextEncoder().encode(str);
      const hash = await crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(hash))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
    }

    // Rate Limiting (Anti-Brute Force)
    function checkRateLimit(): { allowed: boolean; retryAfter?: number } {
      const attempts = Number(localStorage.getItem('baluran_login_attempts') || '0');
      const lockedUntil = Number(localStorage.getItem('baluran_locked_until') || '0');
      const now = Date.now();

      if (lockedUntil > now) {
        return { allowed: false, retryAfter: Math.ceil((lockedUntil - now) / 1000) };
      }
      if (lockedUntil > 0 && lockedUntil <= now) {
        localStorage.removeItem('baluran_locked_until');
        localStorage.setItem('baluran_login_attempts', '0');
        return { allowed: true };
      }
      return { allowed: true };
    }

    function recordFailedAttempt(): { locked: boolean; retryAfter?: number } {
      let attempts = Number(localStorage.getItem('baluran_login_attempts') || '0') + 1;
      localStorage.setItem('baluran_login_attempts', attempts.toString());

      if (attempts >= 5) {
        const lockoutTime = Date.now() + 15 * 60 * 1000; // 15 menit
        localStorage.setItem('baluran_locked_until', lockoutTime.toString());
        return { locked: true, retryAfter: 900 };
      }
      return { locked: false };
    }

    function resetRateLimit() {
      localStorage.removeItem('baluran_login_attempts');
      localStorage.removeItem('baluran_locked_until');
    }

    let globalStore: any = {
      siteSettings: {},
      packages: [],
      destinations: [],
      fleet: [],
      testimonials: [],
      faqs: []
    };

    const loginView = document.getElementById('login-view')!;
    const dashboardView = document.getElementById('dashboard-view')!;
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginAlert = document.getElementById('login-alert')!;
    const loginAlertMsg = document.getElementById('login-alert-msg')!;
    const loginSpinner = document.getElementById('login-spinner')!;
    const btnSubmitLogin = document.getElementById('btn-submit-login')!;
    const btnLogout = document.getElementById('btn-logout')!;
    const toastNotif = document.getElementById('toast-notif')!;
    const toastMsg = document.getElementById('toast-msg')!;

    // Toggle password view
    document.getElementById('toggle-pw')?.addEventListener('click', () => {
      const pwInput = document.getElementById('password') as HTMLInputElement;
      pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
    });

    function showToast(msg: string, isError = false) {
      toastMsg.innerText = msg;
      toastNotif.style.background = isError ? '#e74c3c' : '#2ecc71';
      toastNotif.style.display = 'flex';
      setTimeout(() => {
        toastNotif.style.display = 'none';
      }, 4000);
    }

    // Tab Navigation
    document.querySelectorAll('.menu-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.menu-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        const target = (e.currentTarget as HTMLElement).getAttribute('data-target')!;
        (e.currentTarget as HTMLElement).classList.add('active');
        document.getElementById(target)?.classList.add('active');
      });
    });

    // Check Authentication
    function checkAuth() {
      const isAuth = sessionStorage.getItem('baluran_is_auth') === 'true';
      if (isAuth) {
        showDashboard();
        loadSanityData();
      } else {
        showLogin();
      }
    }

    function showLogin() {
      loginView.style.display = 'flex';
      dashboardView.style.display = 'none';
    }

    function showDashboard() {
      loginView.style.display = 'none';
      dashboardView.style.display = 'block';
    }

    // Login Submission
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginAlert.style.display = 'none';

      // 1. Rate Limit Check
      const rateLimit = checkRateLimit();
      if (!rateLimit.allowed) {
        loginAlertMsg.innerText = `Terlalu banyak percobaan gagal. Akses dibekukan selama ${rateLimit.retryAfter} detik.`;
        loginAlert.style.display = 'flex';
        return;
      }

      // 2. Bot Trap Check
      const trap = (document.getElementById('website_url_trap') as HTMLInputElement).value;
      if (trap && trap.trim() !== '') {
        loginAlertMsg.innerText = 'Akses ditolak.';
        loginAlert.style.display = 'flex';
        return;
      }

      loginSpinner.style.display = 'inline-block';
      btnSubmitLogin.setAttribute('disabled', 'true');

      const username = (document.getElementById('username') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const inputHash = await sha256(password);

        if (username.toLowerCase() === TARGET_USER && inputHash === TARGET_HASH) {
          resetRateLimit();
          sessionStorage.setItem('baluran_is_auth', 'true');
          showDashboard();
          loadSanityData();
          showToast('Login berhasil. Selamat datang Operator Baluran!');
        } else {
          const attempt = recordFailedAttempt();
          loginAlertMsg.innerText = attempt.locked
            ? `Batas 5x percobaan terlampaui. Akses dibekukan selama ${attempt.retryAfter} detik.`
            : 'Username atau Password salah.';
          loginAlert.style.display = 'flex';
        }
      } catch (err) {
        loginAlertMsg.innerText = 'Terjadi kesalahan sistem keamanan.';
        loginAlert.style.display = 'flex';
      } finally {
        loginSpinner.style.display = 'none';
        btnSubmitLogin.removeAttribute('disabled');
      }
    });

    // Logout
    btnLogout.addEventListener('click', () => {
      sessionStorage.removeItem('baluran_is_auth');
      showLogin();
      showToast('Anda telah keluar.');
    });

    // Fetch Live Data
    async function loadSanityData() {
      try {
        const query = encodeURIComponent('*[_type in ["siteSettings", "tourPackage", "destination", "fleet", "testimonial", "faq"]]');
        const url = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/query/${SANITY_DATASET}?query=${query}`;
        const res = await fetch(url);
        const json = await res.json();

        if (json.result) {
          const docs = json.result;
          globalStore.siteSettings = docs.find((d: any) => d._type === 'siteSettings') || {};
          globalStore.packages = docs.filter((d: any) => d._type === 'tourPackage').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.destinations = docs.filter((d: any) => d._type === 'destination').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.fleet = docs.filter((d: any) => d._type === 'fleet').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
          globalStore.testimonials = docs.filter((d: any) => d._type === 'testimonial');
          globalStore.faqs = docs.filter((d: any) => d._type === 'faq').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));

          renderAllData();
        }
      } catch (err) {
        console.error('Gagal memuat data:', err);
        showToast('Gagal memuat data dari cloud database.', true);
      }
    }

    // Save Generic Document
    async function saveDoc(docId: string, fields: Record<string, any>, btnElement: HTMLButtonElement) {
      const originalText = btnElement.innerText;
      btnElement.innerText = 'Menyimpan...';
      btnElement.setAttribute('disabled', 'true');

      // Sanitasi input ketat (Anti-XSS & SQLi)
      const sanitized: Record<string, any> = {};
      for (const [k, v] of Object.entries(fields)) {
        if (typeof v === 'string') {
          sanitized[k] = v.replace(/[<>]/g, '').trim();
        } else {
          sanitized[k] = v;
        }
      }

      const mutations = [
        {
          patch: {
            id: docId,
            set: sanitized
          }
        }
      ];

      try {
        const url = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/mutate/${SANITY_DATASET}`;
        const res = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${SANITY_TOKEN}`
          },
          body: JSON.stringify({ mutations })
        });
        const data = await res.json();

        if (res.ok && data.results) {
          showToast('Data berhasil disimpan permanen ke server!');
        } else {
          showToast('Gagal menyimpan data.', true);
        }
      } catch (err) {
        showToast('Koneksi terputus saat menyimpan.', true);
      } finally {
        btnElement.innerText = originalText;
        btnElement.removeAttribute('disabled');
      }
    }

    // Render Data into Forms
    function renderAllData() {
      renderPackages();
      renderContacts();
      renderDestinations();
      renderFleet();
      renderFaq();
      renderTestimonials();
    }

    // 1. Packages
    function renderPackages() {
      const container = document.getElementById('packages-container')!;
      if (!globalStore.packages || globalStore.packages.length === 0) {
        container.innerHTML = '<div class="empty-state">Belum ada paket Jeep.</div>';
        return;
      }
      container.innerHTML = globalStore.packages.map((pkg: any) => `
        <div class="edit-card">
          <div class="card-header-bar">
            <h3>🚙 ${pkg.title}</h3>
            <span class="badge-tag">${pkg.badge || 'Standar'}</span>
          </div>
          <div class="form-grid">
            <div class="col-6">
              <label>Nama Paket</label>
              <input type="text" id="pkg-title-${pkg._id}" value="${pkg.title || ''}" />
            </div>
            <div class="col-6">
              <label>Harga Sewa (Angka)</label>
              <input type="number" id="pkg-price-${pkg._id}" value="${pkg.price || 0}" />
            </div>
            <div class="col-4">
              <label>Tampilan Format Harga</label>
              <input type="text" id="pkg-priceFmt-${pkg._id}" value="${pkg.priceFormatted || ''}" />
            </div>
            <div class="col-4">
              <label>Durasi</label>
              <input type="text" id="pkg-duration-${pkg._id}" value="${pkg.duration || ''}" />
            </div>
            <div class="col-4">
              <label>Kapasitas</label>
              <input type="text" id="pkg-capacity-${pkg._id}" value="${pkg.capacity || ''}" />
            </div>
            <div class="col-12">
              <label>Lokasi Penjemputan / Meeting Point</label>
              <input type="text" id="pkg-pickup-${pkg._id}" value="${pkg.pickup || ''}" />
            </div>
            <div class="col-12">
              <label>Deskripsi Singkat</label>
              <textarea id="pkg-desc-${pkg._id}" rows="2">${pkg.description || ''}</textarea>
            </div>
          </div>
          <div class="card-footer-action">
            <button class="btn-save" data-id="${pkg._id}">Simpan Perubahan Paket</button>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.btn-save').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const title = (document.getElementById(`pkg-title-${id}`) as HTMLInputElement).value;
          const price = Number((document.getElementById(`pkg-price-${id}`) as HTMLInputElement).value);
          const priceFormatted = (document.getElementById(`pkg-priceFmt-${id}`) as HTMLInputElement).value;
          const duration = (document.getElementById(`pkg-duration-${id}`) as HTMLInputElement).value;
          const capacity = (document.getElementById(`pkg-capacity-${id}`) as HTMLInputElement).value;
          const pickup = (document.getElementById(`pkg-pickup-${id}`) as HTMLInputElement).value;
          const description = (document.getElementById(`pkg-desc-${id}`) as HTMLTextAreaElement).value;

          saveDoc(id, {
            title, price, priceFormatted, duration, capacity, pickup, description
          }, e.currentTarget as HTMLButtonElement);
        });
      });
    }

    // 2. Contacts
    function renderContacts() {
      const container = document.getElementById('contacts-container')!;
      const s = globalStore.siteSettings || {};
      container.innerHTML = `
        <div class="form-grid">
          <div class="col-6">
            <label>Nomor WhatsApp Booking (Aktif)</label>
            <input type="text" id="set-wa" value="${s.whatsapp || '085333050863'}" placeholder="Contoh: 085333050863" />
            <small class="hint-text">Nomor ini yang langsung dihubungi wisatawan saat menekan tombol WhatsApp Booking.</small>
          </div>
          <div class="col-6">
            <label>Nomor Telepon Cadangan</label>
            <input type="text" id="set-phone" value="${s.phone || '085333050863'}" />
          </div>
          <div class="col-12">
            <label>Nama Usaha / Operator</label>
            <input type="text" id="set-fullname" value="${s.fullName || 'BALURAN INDONESIA - Jeep Safari Baluran'}" />
          </div>
          <div class="col-12">
            <label>Deskripsi Singkat</label>
            <textarea id="set-desc" rows="2">${s.description || ''}</textarea>
          </div>
          <div class="col-4">
            <label>Link Instagram</label>
            <input type="text" id="set-ig" value="${s.instagram || ''}" placeholder="https://instagram.com/..." />
          </div>
          <div class="col-4">
            <label>Link Facebook</label>
            <input type="text" id="set-fb" value="${s.facebook || ''}" />
          </div>
          <div class="col-4">
            <label>Link YouTube</label>
            <input type="text" id="set-yt" value="${s.youtube || ''}" />
          </div>
        </div>
        <div class="card-footer-action">
          <button class="btn-save" id="btn-save-contacts">Simpan Pengaturan Kontak & WhatsApp</button>
        </div>
      `;

      document.getElementById('btn-save-contacts')?.addEventListener('click', (e) => {
        const whatsapp = (document.getElementById('set-wa') as HTMLInputElement).value;
        const phone = (document.getElementById('set-phone') as HTMLInputElement).value;
        const fullName = (document.getElementById('set-fullname') as HTMLInputElement).value;
        const description = (document.getElementById('set-desc') as HTMLTextAreaElement).value;
        const instagram = (document.getElementById('set-ig') as HTMLInputElement).value;
        const facebook = (document.getElementById('set-fb') as HTMLInputElement).value;
        const youtube = (document.getElementById('set-yt') as HTMLInputElement).value;

        saveDoc('siteSettings', {
          whatsapp, phone, fullName, description, instagram, facebook, youtube
        }, e.currentTarget as HTMLButtonElement);
      });
    }

    // 3. Destinations
    function renderDestinations() {
      const container = document.getElementById('destinations-container')!;
      if (!globalStore.destinations || globalStore.destinations.length === 0) {
        container.innerHTML = '<div class="empty-state">Belum ada destinasi.</div>';
        return;
      }
      container.innerHTML = globalStore.destinations.map((d: any) => `
        <div class="edit-card">
          <div class="card-header-bar">
            <h3>📍 ${d.title}</h3>
            <span class="badge-tag">${d.priceFormatted || ''}</span>
          </div>
          <div class="form-grid">
            <div class="col-6">
              <label>Nama Destinasi</label>
              <input type="text" id="dest-title-${d._id}" value="${d.title || ''}" />
            </div>
            <div class="col-6">
              <label>Harga Tampilan</label>
              <input type="text" id="dest-price-${d._id}" value="${d.priceFormatted || ''}" />
            </div>
            <div class="col-6">
              <label>Durasi Tour</label>
              <input type="text" id="dest-dur-${d._id}" value="${d.duration || ''}" />
            </div>
            <div class="col-6">
              <label>Kapasitas</label>
              <input type="text" id="dest-cap-${d._id}" value="${d.capacity || ''}" />
            </div>
            <div class="col-12">
              <label>Deskripsi Tempat</label>
              <textarea id="dest-desc-${d._id}" rows="2">${d.description || ''}</textarea>
            </div>
          </div>
          <div class="card-footer-action">
            <button class="btn-save" data-id="${d._id}">Simpan Destinasi</button>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.btn-save').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const title = (document.getElementById(`dest-title-${id}`) as HTMLInputElement).value;
          const priceFormatted = (document.getElementById(`dest-price-${id}`) as HTMLInputElement).value;
          const duration = (document.getElementById(`dest-dur-${id}`) as HTMLInputElement).value;
          const capacity = (document.getElementById(`dest-cap-${id}`) as HTMLInputElement).value;
          const description = (document.getElementById(`dest-desc-${id}`) as HTMLTextAreaElement).value;

          saveDoc(id, {
            title, priceFormatted, duration, capacity, description
          }, e.currentTarget as HTMLButtonElement);
        });
      });
    }

    // 4. Fleet
    function renderFleet() {
      const container = document.getElementById('fleet-container')!;
      if (!globalStore.fleet || globalStore.fleet.length === 0) {
        container.innerHTML = '<div class="empty-state">Belum ada armada.</div>';
        return;
      }
      container.innerHTML = globalStore.fleet.map((f: any) => `
        <div class="fleet-item-card">
          <h4>🛞 ${f.name}</h4>
          <div class="form-group">
            <label>Nama Unit</label>
            <input type="text" id="fl-name-${f._id}" value="${f.name || ''}" />
          </div>
          <div class="form-group">
            <label>Karakter Warna</label>
            <input type="text" id="fl-color-${f._id}" value="${f.colorName || ''}" />
          </div>
          <div class="form-group">
            <label>Tagline</label>
            <input type="text" id="fl-tag-${f._id}" value="${f.tag || ''}" />
          </div>
          <button class="btn-save" data-id="${f._id}">Simpan Armada</button>
        </div>
      `).join('');

      container.querySelectorAll('.btn-save').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const name = (document.getElementById(`fl-name-${id}`) as HTMLInputElement).value;
          const colorName = (document.getElementById(`fl-color-${id}`) as HTMLInputElement).value;
          const tag = (document.getElementById(`fl-tag-${id}`) as HTMLInputElement).value;

          saveDoc(id, { name, colorName, tag }, e.currentTarget as HTMLButtonElement);
        });
      });
    }

    // 5. FAQ
    function renderFaq() {
      const container = document.getElementById('faq-container')!;
      if (!globalStore.faqs || globalStore.faqs.length === 0) {
        container.innerHTML = '<div class="empty-state">Belum ada FAQ.</div>';
        return;
      }
      container.innerHTML = globalStore.faqs.map((q: any) => `
        <div class="edit-card">
          <div class="form-group">
            <label>Pertanyaan</label>
            <input type="text" id="faq-q-${q._id}" value="${q.question || ''}" />
          </div>
          <div class="form-group">
            <label>Jawaban</label>
            <textarea id="faq-a-${q._id}" rows="3">${q.answer || ''}</textarea>
          </div>
          <div class="card-footer-action">
            <button class="btn-save" data-id="${q._id}">Simpan FAQ</button>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.btn-save').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const question = (document.getElementById(`faq-q-${id}`) as HTMLInputElement).value;
          const answer = (document.getElementById(`faq-a-${id}`) as HTMLTextAreaElement).value;

          saveDoc(id, { question, answer }, e.currentTarget as HTMLButtonElement);
        });
      });
    }

    // 6. Testimonials
    function renderTestimonials() {
      const container = document.getElementById('testimonials-container')!;
      if (!globalStore.testimonials || globalStore.testimonials.length === 0) {
        container.innerHTML = '<div class="empty-state">Belum ada testimoni.</div>';
        return;
      }
      container.innerHTML = globalStore.testimonials.map((t: any) => `
        <div class="edit-card">
          <div class="form-grid">
            <div class="col-6">
              <label>Nama Wisatawan</label>
              <input type="text" id="testi-name-${t._id}" value="${t.name || ''}" />
            </div>
            <div class="col-6">
              <label>Kota Asal</label>
              <input type="text" id="testi-city-${t._id}" value="${t.city || ''}" />
            </div>
            <div class="col-12">
              <label>Kutipan Review</label>
              <textarea id="testi-quote-${t._id}" rows="2">${t.quote || ''}</textarea>
            </div>
          </div>
          <div class="card-footer-action">
            <button class="btn-save" data-id="${t._id}">Simpan Testimoni</button>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.btn-save').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const name = (document.getElementById(`testi-name-${id}`) as HTMLInputElement).value;
          const city = (document.getElementById(`testi-city-${id}`) as HTMLInputElement).value;
          const quote = (document.getElementById(`testi-quote-${id}`) as HTMLTextAreaElement).value;

          saveDoc(id, { name, city, quote }, e.currentTarget as HTMLButtonElement);
        });
      });
    }

    // Init Check
    checkAuth();
  </script>
</Layout>

