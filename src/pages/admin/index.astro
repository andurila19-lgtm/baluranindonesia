---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../data/baluranData';

const isDev = import.meta.env.DEV;
const studioUrl = isDev 
  ? 'http://localhost:3333' 
  : (import.meta.env.PUBLIC_SANITY_STUDIO_URL || 'https://baluran-indonesia.sanity.studio');
---

<Layout
  title="Baluran Indonesia - CMS Admin Portal"
  description="Portal akses dashboard pengelolaan konten Baluran Indonesia Studio."
>
  <head slot="head">
    <meta http-equiv="refresh" content={`0;url=${studioUrl}`} />
  </head>

  <main class="portal-wrapper">
    <div class="portal-card">
      <div class="portal-icon">🚙</div>
      <div class="portal-badge">CMS ADMIN PORTAL</div>
      <h1 class="portal-title">Baluran Indonesia Studio</h1>
      <p class="portal-desc">
        Sedang mengalihkan Anda ke Dashboard Sanity Studio untuk mengelola paket Jeep, harga, armada, dan konten website...
      </p>

      <div class="portal-loading">
        <div class="spinner"></div>
        <span>Membuka {isDev ? 'Local Studio (Port 3333)' : 'Sanity Cloud Studio'}...</span>
      </div>

      <div class="portal-actions">
        <a href={studioUrl} class="btn-primary" id="open-studio-btn">
          Buka Dashboard Sanity Sekarang &rarr;
        </a>
        <a href="/" class="btn-secondary">
          &larr; Kembali ke Website
        </a>
      </div>
    </div>
  </main>

  <script define:vars={{ studioUrl }}>
    // Auto redirect instantly
    if (typeof window !== 'undefined') {
      window.location.replace(studioUrl);
    }
  </script>
</Layout>

<style>
  .portal-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #16402d 0%, #0a1f16 100%);
    padding: 2rem 1rem;
    font-family: inherit;
    color: #ffffff;
  }

  .portal-card {
    max-width: 520px;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .portal-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .portal-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: rgba(46, 204, 113, 0.15);
    border: 1px solid rgba(46, 204, 113, 0.3);
    color: #2ecc71;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .portal-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .portal-desc {
    color: #a3b899;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .portal-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #cbd5e1;
    margin-bottom: 2rem;
  }

  .spinner {
    width: 20px;
    height: 20px;
    border: 3px solid rgba(46, 204, 113, 0.2);
    border-top-color: #2ecc71;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .portal-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    background: #2ecc71;
    color: #0a1f16;
    font-weight: 700;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(46, 204, 113, 0.3);
  }

  .btn-primary:hover {
    background: #27ae60;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(46, 204, 113, 0.4);
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: #94a3b8;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-secondary:hover {
    color: #ffffff;
  }
</style>
