</style>

<script>
  import { supabase } from '../../../lib/supabase';

  // Validasi sesi aktif secara real-time dengan Supabase
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) {
      sessionStorage.removeItem('baluran_admin_auth');
      window.location.replace('/admin');
    }
  });

  const SANITY_PROJECT_ID = '7ox4kuc2';
  const SANITY_DATASET = 'production';

  // --- STATE ---
  let activePage = '/';
  let cleanPreviewMode = false;
  let activeSectionId = '';
  let discoveredSections: Array<{ id: string; name: string; icon: string; el: HTMLElement }> = [];
  let pageLayoutState: {
    order: string[];
    grids: Record<string, number>;
    borders: Record<string, string>;
    images: Record<string, string>;
  } = {
    order: [],
    grids: {},
    borders: {},
    images: {}
  };

  // --- DOM ELEMENTS ---
  const pageSelector = document.getElementById('page-selector') as HTMLSelectElement;
  const siteFrame = document.getElementById('site-frame') as HTMLIFrameElement;
  const frameLoader = document.getElementById('frame-loader')!;
  const btnCleanToggle = document.getElementById('btn-clean-toggle')!;
  const btnSaveTop = document.getElementById('btn-save-changes')!;
  const btnSaveSidebar = document.getElementById('btn-save-sidebar')!;
  const btnResetOrder = document.getElementById('btn-reset-order')!;
  const btnViewLive = document.getElementById('btn-view-live') as HTMLAnchorElement;
  const btnLogout = document.getElementById('btn-logout')!;

  const sectionsTreeList = document.getElementById('sections-tree-list')!;
  const inspectorSecName = document.getElementById('inspector-sec-name')!;
  const inspectorEmpty = document.getElementById('inspector-empty')!;
  const inspectorForm = document.getElementById('inspector-form')!;
  const inspectorHeadline = document.getElementById('inspector-headline') as HTMLInputElement;
  const inspectorSubtitle = document.getElementById('inspector-subtitle') as HTMLTextAreaElement;
  const inspectorVisibility = document.getElementById('inspector-visibility') as HTMLInputElement;
  const inspectorFileInput = document.getElementById('inspector-file-input') as HTMLInputElement;
  const inspectorCurrentImg = document.getElementById('inspector-current-img') as HTMLImageElement;
  const uploadStatusText = document.getElementById('upload-status-text')!;
  const builderToast = document.getElementById('builder-toast')!;
  const toastMsg = document.getElementById('toast-msg')!;

  // Device buttons
  const deviceButtons = document.querySelectorAll('.btn-device');
  // Sidebar tab buttons
  const sideTabButtons = document.querySelectorAll('.side-tab-btn');
  // Grid column buttons
  const gridColButtons = document.querySelectorAll('.btn-grid-col');
  // Border buttons
  const borderButtons = document.querySelectorAll('.btn-border-style');

  // --- LOGOUT ---
  btnLogout?.addEventListener('click', async () => {
    try {
      await supabase.auth.signOut();
    } catch (e) {}
    sessionStorage.removeItem('baluran_admin_auth');
    localStorage.removeItem('baluran_supabase_auth');
    window.location.replace('/admin');
  });

  // --- PAGE SWITCHER ---
  pageSelector?.addEventListener('change', (e) => {
    activePage = (e.target as HTMLSelectElement).value;
    loadPage(activePage);
  });

  // --- DEVICE SWITCHER ---
  deviceButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      deviceButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const dev = btn.getAttribute('data-device');
      siteFrame.className = 'site-frame frame-' + dev;
    });
  });

  // --- CLEAN PREVIEW TOGGLE ---
  btnCleanToggle?.addEventListener('click', () => {
    cleanPreviewMode = !cleanPreviewMode;
    btnCleanToggle.classList.toggle('active', cleanPreviewMode);
    toggleFrameCleanMode(cleanPreviewMode);
  });

  // --- SIDEBAR TAB SWITCHING ---
  sideTabButtons.forEach(tab => {
    tab.addEventListener('click', () => {
      sideTabButtons.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.getAttribute('data-tab');
      document.querySelectorAll('.side-tab-content').forEach(c => c.classList.remove('active'));
      document.getElementById(target || '')?.classList.add('active');
    });
  });

  // --- LOAD PAGE IN IFRAME ---
  function loadPage(url: string) {
    frameLoader.style.display = 'flex';
    frameLoader.style.opacity = '1';
    btnViewLive.href = url;

    // Load saved layout config for this page
    loadStoredLayout(url);

    siteFrame.src = url;
  }

  function loadStoredLayout(path: string) {
    const key = 'baluran_custom_layout_' + (path.replace(/\/$/, '') || '/');
    try {
      const raw = localStorage.getItem(key);
      if (raw) {
        pageLayoutState = JSON.parse(raw);
      } else {
        pageLayoutState = { order: [], grids: {}, borders: {}, images: {} };
      }
    } catch (e) {
      pageLayoutState = { order: [], grids: {}, borders: {}, images: {} };
    }
  }

  // --- IFRAME LOADED & INTERACTIVE BRIDGE ---
  siteFrame.addEventListener('load', () => {
    setTimeout(() => {
      frameLoader.style.opacity = '0';
      setTimeout(() => { frameLoader.style.display = 'none'; }, 300);
      setupIframeVisualBuilder();
    }, 400);
  });

  function setupIframeVisualBuilder() {
    try {
      const doc = siteFrame.contentDocument;
      if (!doc) return;

      // 1. Inject Elementor / Builder CSS into the live website
      injectBuilderStyles(doc);

      // 2. Discover all sections on the live website
      discoverSections(doc);

      // 3. Apply any saved order / grid / border customizations to the live website
      applySavedStateToDoc(doc);

      // 4. Render sections in Left Sidebar Navigator
      renderSidebarSectionsList();

      // 5. Attach Elementor-style on-page hover toolbars & direct drag-and-drop
      attachOnPageElementorHooks(doc);

    } catch (err) {
      console.warn('Builder bridge warning:', err);
    }
  }

  function injectBuilderStyles(doc: Document) {
    let style = doc.getElementById('baluran-builder-injected-style');
    if (!style) {
      style = doc.createElement('style');
      style.id = 'baluran-builder-injected-style';
      doc.head.appendChild(style);
    }

    style.textContent = `
      .bb-section-wrap {
        position: relative !important;
        transition: outline 0.2s ease, box-shadow 0.2s ease;
      }
      .bb-section-wrap:hover {
        outline: 2px dashed #10b981 !important;
        outline-offset: -2px !important;
      }
      .bb-section-wrap.bb-active {
        outline: 3px solid #10b981 !important;
        outline-offset: -2px !important;
      }
      .bb-floating-bar {
        position: absolute;
        top: 8px;
        left: 12px;
        z-index: 999999;
        display: none;
        align-items: center;
        gap: 6px;
        background: #091411;
        border: 1px solid #10b981;
        padding: 4px 8px;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        color: #ffffff;
        font-family: system-ui, sans-serif;
        font-size: 11px;
        font-weight: 700;
        pointer-events: auto;
      }
      .bb-section-wrap:hover .bb-floating-bar {
        display: flex !important;
      }
      .bb-bar-btn {
        background: rgba(255,255,255,0.1);
        border: none;
        color: #ffffff;
        padding: 2px 6px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 11px;
      }
      .bb-bar-btn:hover {
        background: #10b981;
        color: #06120e;
      }
      .bb-clean-mode .bb-section-wrap:hover {
        outline: none !important;
      }
      .bb-clean-mode .bb-section-wrap.bb-active {
        outline: none !important;
      }
      .bb-clean-mode .bb-floating-bar {
        display: none !important;
      }
    `;
  }

  function discoverSections(doc: Document) {
    discoveredSections = [];
    const main = doc.querySelector('main') || doc.body;

    const elements = Array.from(main.children).filter(el => {
      const tag = el.tagName.toLowerCase();
      return tag === 'section' || tag === 'header' || tag === 'article' || el.classList.contains('section');
    }) as HTMLElement[];

    elements.forEach((el, idx) => {
      let id = el.id || el.getAttribute('data-section-id') || '';
      if (!id) {
        const cls = Array.from(el.classList).find(c => c.endsWith('-section') || c.endsWith('-content') || c === 'hero-section');
        id = cls || 'section-' + idx;
        el.id = id;
      }

      const { name, icon } = getSectionLabel(id, el);
      discoveredSections.push({ id, name, icon, el });
    });
  }

  function getSectionLabel(id: string, el: HTMLElement): { name: string; icon: string } {
    const lower = id.toLowerCase() + ' ' + (el.className || '');
    if (lower.includes('hero')) return { name: 'Hero Banner Utama', icon: '🌟' };
    if (lower.includes('paket') || lower.includes('package')) return { name: 'Paket Jeep Safari', icon: '🚙' };
    if (lower.includes('why') || lower.includes('keunggulan')) return { name: 'Mengapa Baluran Indonesia', icon: '⭐' };
    if (lower.includes('destin') || lower.includes('destination')) return { name: 'Destinasi Sekitar (Wurung/Djawatan)', icon: '📍' };
    if (lower.includes('facil') || lower.includes('fasilitas')) return { name: 'Fasilitas & Ketentuan', icon: '🛠️' };
    if (lower.includes('fleet') || lower.includes('armada')) return { name: 'Galeri Armada Jeep 4x4', icon: '🛞' };
    if (lower.includes('testi')) return { name: 'Testimoni Tamu', icon: '💬' };
    if (lower.includes('faq') || lower.includes('panduan')) return { name: 'Panduan & Tanya Jawab (FAQ)', icon: '❓' };
    if (lower.includes('cta') || lower.includes('booking')) return { name: 'Banner Call to Action', icon: '📣' };
    if (lower.includes('header')) return { name: 'Header Halaman', icon: '🏷️' };
    return { name: id.replace(/[-_]/g, ' ').replace(/\b\w/g, l => l.toUpperCase()), icon: '📄' };
  }

  function applySavedStateToDoc(doc: Document) {
    const main = doc.querySelector('main') || doc.body;

    // Apply Saved Order
    if (Array.isArray(pageLayoutState.order) && pageLayoutState.order.length > 0) {
      pageLayoutState.order.forEach(id => {
        const item = discoveredSections.find(s => s.id === id);
        if (item && item.el) {
          main.appendChild(item.el);
        }
      });
      discoverSections(doc);
    }

    // Apply Saved Grids
    if (pageLayoutState.grids) {
      Object.entries(pageLayoutState.grids).forEach(([id, cols]) => {
        const item = discoveredSections.find(s => s.id === id);
        if (item) applyGridToElement(item.el, cols);
      });
    }

    // Apply Saved Borders
    if (pageLayoutState.borders) {
      Object.entries(pageLayoutState.borders).forEach(([id, style]) => {
        const item = discoveredSections.find(s => s.id === id);
        if (item) applyBorderToElement(item.el, style);
      });
    }

    // Apply Saved Images
    if (pageLayoutState.images) {
      Object.entries(pageLayoutState.images).forEach(([selector, src]) => {
        const img = doc.querySelector(selector) as HTMLImageElement;
        if (img && src) img.src = src;
      });
    }
  }

  // --- RENDER SIDEBAR SECTIONS TREE ---
  function renderSidebarSectionsList() {
    sectionsTreeList.innerHTML = '';

    if (discoveredSections.length === 0) {
      sectionsTreeList.innerHTML = '<div class="tree-loading">Tidak ada seksi kontainer terdeteksi pada halaman ini.</div>';
      return;
    }

    discoveredSections.forEach((sec, idx) => {
      const item = document.createElement('div');
      item.className = 'section-tree-item' + (sec.id === activeSectionId ? ' selected' : '');
      item.setAttribute('draggable', 'true');
      item.setAttribute('data-sec-id', sec.id);

      item.innerHTML = `
        <div class="tree-item-left">
          <span class="drag-grip" title="Tarik untuk memindahkan">⠿</span>
          <span class="sec-tree-icon">${sec.icon}</span>
          <span class="sec-tree-name">${sec.name}</span>
        </div>
        <div class="tree-item-actions">
          <button type="button" class="btn-tree-action btn-move-up" title="Pindah ke atas" data-id="${sec.id}">▲</button>
          <button type="button" class="btn-tree-action btn-move-down" title="Pindah ke bawah" data-id="${sec.id}">▼</button>
          <button type="button" class="btn-tree-action btn-inspect-sec" title="Kustomisasi seksi" data-id="${sec.id}">⚙️</button>
        </div>
      `;

      // Select section on click
      item.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('btn-move-up') || target.classList.contains('btn-move-down')) return;
        selectSection(sec.id);
      });

      // Quick move buttons
      const btnUp = item.querySelector('.btn-move-up')!;
      const btnDown = item.querySelector('.btn-move-down')!;

      btnUp.addEventListener('click', (e) => {
        e.stopPropagation();
        moveSectionIndex(idx, idx - 1);
      });

      btnDown.addEventListener('click', (e) => {
        e.stopPropagation();
        moveSectionIndex(idx, idx + 1);
      });

      // DRAG AND DROP IN SIDEBAR LIST
      item.addEventListener('dragstart', (e) => {
        item.classList.add('dragging');
        e.dataTransfer?.setData('text/plain', sec.id);
      });

      item.addEventListener('dragend', () => {
        item.classList.remove('dragging');
        document.querySelectorAll('.section-tree-item').forEach(el => el.classList.remove('drag-over'));
      });

      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        item.classList.add('drag-over');
      });

      item.addEventListener('dragleave', () => {
        item.classList.remove('drag-over');
      });

      item.addEventListener('drop', (e) => {
        e.preventDefault();
        item.classList.remove('drag-over');
        const draggedId = e.dataTransfer?.getData('text/plain');
        if (draggedId && draggedId !== sec.id) {
          const fromIdx = discoveredSections.findIndex(s => s.id === draggedId);
          const toIdx = idx;
          if (fromIdx !== -1) {
            moveSectionIndex(fromIdx, toIdx);
          }
        }
      });

      sectionsTreeList.appendChild(item);
    });
  }

  function moveSectionIndex(fromIdx: number, toIdx: number) {
    if (toIdx < 0 || toIdx >= discoveredSections.length || fromIdx === toIdx) return;

    const doc = siteFrame.contentDocument;
    if (!doc) return;

    const main = doc.querySelector('main') || doc.body;
    const movedItem = discoveredSections[fromIdx];
    const targetItem = discoveredSections[toIdx];

    if (toIdx > fromIdx) {
      main.insertBefore(movedItem.el, targetItem.el.nextSibling);
    } else {
      main.insertBefore(movedItem.el, targetItem.el);
    }

    discoverSections(doc);
    updateStoredOrder();
    renderSidebarSectionsList();

    movedItem.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    showToast('Posisi seksi ' + movedItem.name + ' berhasil diubah');
  }

  function updateStoredOrder() {
    pageLayoutState.order = discoveredSections.map(s => s.id);
  }

  // --- ON-PAGE ELEMENTOR HOOKS (IN IFRAME) ---
  function attachOnPageElementorHooks(doc: Document) {
    discoveredSections.forEach((sec, idx) => {
      const el = sec.el;
      el.classList.add('bb-section-wrap');

      let bar = el.querySelector('.bb-floating-bar') as HTMLElement;
      if (!bar) {
        bar = doc.createElement('div');
        bar.className = 'bb-floating-bar';
        bar.innerHTML = `
          <span>⠿ ${sec.name}</span>
          <button type="button" class="bb-bar-btn bb-btn-up" title="Pindah ke atas">▲</button>
          <button type="button" class="bb-bar-btn bb-btn-down" title="Pindah ke bawah">▼</button>
          <button type="button" class="bb-bar-btn bb-btn-edit" title="Buka di Sidebar">⚙️ Edit</button>
        `;

        bar.querySelector('.bb-btn-up')?.addEventListener('click', (e) => {
          e.stopPropagation();
          moveSectionIndex(idx, idx - 1);
        });

        bar.querySelector('.bb-btn-down')?.addEventListener('click', (e) => {
          e.stopPropagation();
          moveSectionIndex(idx, idx + 1);
        });

        bar.querySelector('.bb-btn-edit')?.addEventListener('click', (e) => {
          e.stopPropagation();
          selectSection(sec.id);
        });

        el.prepend(bar);
      }

      el.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a');
        if (link && !link.classList.contains('bb-bar-btn')) {
          e.preventDefault();
        }
        selectSection(sec.id);
      });
    });
  }

  function toggleFrameCleanMode(clean: boolean) {
    const doc = siteFrame.contentDocument;
    if (!doc) return;
    if (clean) {
      doc.body.classList.add('bb-clean-mode');
    } else {
      doc.body.classList.remove('bb-clean-mode');
    }
  }

  // --- SECTION INSPECTOR ---
  function selectSection(id: string) {
    activeSectionId = id;
    const sec = discoveredSections.find(s => s.id === id);
    if (!sec) return;

    const doc = siteFrame.contentDocument;
    if (doc) {
      doc.querySelectorAll('.bb-section-wrap').forEach(el => el.classList.remove('bb-active'));
      sec.el.classList.add('bb-active');
      sec.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    sideTabButtons.forEach(t => t.classList.remove('active'));
    document.querySelector('[data-tab="tab-inspector"]')?.classList.add('active');
    document.querySelectorAll('.side-tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById('tab-inspector')?.classList.add('active');

    inspectorSecName.textContent = sec.name;
    inspectorEmpty.style.display = 'none';
    inspectorForm.style.display = 'block';

    const headingEl = sec.el.querySelector('h1, h2, h3, .section-title, .hero-title') as HTMLElement;
    const subEl = sec.el.querySelector('p, .section-subtitle, .hero-desc') as HTMLElement;
    inspectorHeadline.value = headingEl ? headingEl.textContent?.trim() || '' : '';
    inspectorSubtitle.value = subEl ? subEl.textContent?.trim() || '' : '';

    const imgEl = sec.el.querySelector('img') as HTMLImageElement;
    if (imgEl && imgEl.src) {
      inspectorCurrentImg.src = imgEl.src;
    } else {
      inspectorCurrentImg.src = '/images/hero-baluran.webp';
    }

    const currentCols = pageLayoutState.grids[id] || 3;
    gridColButtons.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-cols') === String(currentCols));
    });

    const currentBorder = pageLayoutState.borders[id] || 'none';
    borderButtons.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-border') === currentBorder);
    });

    document.querySelectorAll('.section-tree-item').forEach(item => {
      item.classList.toggle('selected', item.getAttribute('data-sec-id') === id);
    });
  }

  inspectorHeadline.addEventListener('input', () => {
    if (!activeSectionId) return;
    const sec = discoveredSections.find(s => s.id === activeSectionId);
    if (!sec) return;
    const headingEl = sec.el.querySelector('h1, h2, h3, .section-title, .hero-title') as HTMLElement;
    if (headingEl) headingEl.textContent = inspectorHeadline.value;
  });

  inspectorSubtitle.addEventListener('input', () => {
    if (!activeSectionId) return;
    const sec = discoveredSections.find(s => s.id === activeSectionId);
    if (!sec) return;
    const subEl = sec.el.querySelector('p, .section-subtitle, .hero-desc') as HTMLElement;
    if (subEl) subEl.textContent = inspectorSubtitle.value;
  });

  inspectorVisibility.addEventListener('change', () => {
    if (!activeSectionId) return;
    const sec = discoveredSections.find(s => s.id === activeSectionId);
    if (!sec) return;
    sec.el.style.display = inspectorVisibility.checked ? '' : 'none';
  });

  gridColButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!activeSectionId) return;
      const sec = discoveredSections.find(s => s.id === activeSectionId);
      if (!sec) return;

      const cols = Number(btn.getAttribute('data-cols') || '3');
      gridColButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      pageLayoutState.grids[activeSectionId] = cols;
      applyGridToElement(sec.el, cols);
      showToast('Grid kolom seksi ' + sec.name + ' diubah ke ' + cols + ' kolom');
    });
  });

  function applyGridToElement(el: HTMLElement, cols: number) {
    const gridContainer = (el.querySelector('.packages-grid, .destinations-grid, .fleet-grid, .facilities-grid, .testi-grid, .why-grid, .packages-list-grid') || el) as HTMLElement;
    if (gridContainer) {
      gridContainer.style.display = 'grid';
      gridContainer.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;
      gridContainer.style.gap = '1.5rem';
    }
  }

  borderButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!activeSectionId) return;
      const sec = discoveredSections.find(s => s.id === activeSectionId);
      if (!sec) return;

      const style = btn.getAttribute('data-border') || 'none';
      borderButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      pageLayoutState.borders[activeSectionId] = style;
      applyBorderToElement(sec.el, style);
      showToast('Gaya border seksi ' + sec.name + ' diperbarui');
    });
  });

  function applyBorderToElement(el: HTMLElement, style: string) {
    const target = (el.querySelector('.container') || el) as HTMLElement;
    if (!target) return;

    if (style === 'subtle') {
      target.style.border = '1px solid rgba(255, 255, 255, 0.12)';
      target.style.borderRadius = '1rem';
      target.style.boxShadow = 'none';
      target.style.padding = '2rem 1.5rem';
    } else if (style === 'accent') {
      target.style.border = '2px solid #10b981';
      target.style.borderRadius = '1rem';
      target.style.boxShadow = '0 0 25px rgba(16, 185, 129, 0.15)';
      target.style.padding = '2rem 1.5rem';
    } else {
      target.style.border = 'none';
      target.style.boxShadow = 'none';
    }
  }

  inspectorFileInput.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file || !activeSectionId) return;

    const sec = discoveredSections.find(s => s.id === activeSectionId);
    if (!sec) return;

    uploadStatusText.textContent = 'Mengunggah ke Sanity CDN...';
    uploadStatusText.style.color = 'var(--wp-accent)';

    try {
      const url = `https://${SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/assets/images/${SANITY_DATASET}?filename=${encodeURIComponent(file.name)}`;
      const res = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': file.type,
          ...(localStorage.getItem('sanity_write_token') ? {
            'Authorization': `Bearer ${localStorage.getItem('sanity_write_token')}`
          } : {})
        },
        body: file
      });

      let imageUrl = '';
      if (res.ok) {
        const data = await res.json();
        imageUrl = data.document?.url || URL.createObjectURL(file);
      } else {
        imageUrl = URL.createObjectURL(file);
      }

      inspectorCurrentImg.src = imageUrl;

      const imgInDoc = sec.el.querySelector('img') as HTMLImageElement;
      if (imgInDoc) {
        imgInDoc.src = imageUrl;
        const selector = `#${sec.id} img`;
        pageLayoutState.images[selector] = imageUrl;
      }

      uploadStatusText.textContent = 'Gambar berhasil diperbarui!';
      uploadStatusText.style.color = '#34d399';
      showToast('Foto seksi ' + sec.name + ' berhasil diupload!');
    } catch (err) {
      const localUrl = URL.createObjectURL(file);
      inspectorCurrentImg.src = localUrl;
      const imgInDoc = sec.el.querySelector('img') as HTMLImageElement;
      if (imgInDoc) imgInDoc.src = localUrl;
      uploadStatusText.textContent = 'Tersimpan lokal (Pratinjau)';
      uploadStatusText.style.color = '#fbbf24';
      showToast('Foto diperbarui di pratinjau live');
    }
  });

  function saveAllChanges() {
    updateStoredOrder();
    const key = 'baluran_custom_layout_' + (activePage.replace(/\/$/, '') || '/');

    try {
      localStorage.setItem(key, JSON.stringify(pageLayoutState));
      showToast('Susunan seksi dan kustomisasi visual berhasil disimpan!');
    } catch (err) {
      showToast('Gagal menyimpan ke penyimpanan lokal');
    }
  }

  btnSaveTop.addEventListener('click', saveAllChanges);
  btnSaveSidebar.addEventListener('click', saveAllChanges);

  btnResetOrder.addEventListener('click', () => {
    if (confirm('Kembalikan urutan susunan seksi ke posisi awal?')) {
      const key = 'baluran_custom_layout_' + (activePage.replace(/\/$/, '') || '/');
      localStorage.removeItem(key);
      loadPage(activePage);
      showToast('Susunan seksi berhasil di-reset');
    }
  });

  let toastTimer: any = null;
  function showToast(text: string) {
    if (toastTimer) clearTimeout(toastTimer);
    toastMsg.textContent = text;
    builderToast.style.display = 'flex';
    toastTimer = setTimeout(() => {
      builderToast.style.display = 'none';
    }, 3500);
  }

  // Load initial page
  loadPage(activePage);
</script>
