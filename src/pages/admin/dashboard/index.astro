---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Visual Site Builder & Dashboard - Baluran Indonesia"
  description="Editor visual live website dengan drag and drop, grid kontainer, dan kustomisasi langsung pada halaman website asli."
>
  <!-- IMMEDIATE AUTH GATE: Redirect unauthorized visitors to /admin -->
  <script is:inline>
    (function() {
      try {
        var raw = sessionStorage.getItem('baluran_admin_auth');
        if (!raw) {
          window.location.replace('/admin');
          return;
        }
        var auth = JSON.parse(raw);
        if (!auth || !auth.expiresAt || auth.expiresAt < Date.now()) {
          sessionStorage.removeItem('baluran_admin_auth');
          window.location.replace('/admin');
          return;
        }
      } catch (e) {
        window.location.replace('/admin');
      }
    })();
  </script>

  <main class="builder-app" id="builder-app">
    <!-- TOP CONTROL BAR -->
    <header class="wp-topbar">
      <div class="topbar-left">
        <div class="brand-logo">
          <span class="logo-icon">🚙</span>
          <div class="logo-text">
            <span class="logo-title">BALURAN BUILDER</span>
            <span class="logo-sub">WordPress / Elementor Live Mode</span>
          </div>
        </div>

        <!-- Page Selector Dropdown -->
        <div class="page-switcher-wrap">
          <label for="page-selector" class="page-select-label">Halaman:</label>
          <select id="page-selector" class="page-select">
            <option value="/" selected>🏠 Beranda (/)</option>
            <option value="/paket/">📦 Paket Jeep Safari (/paket)</option>
            <option value="/destinasi/">📍 Destinasi Sekitar (/destinasi)</option>
            <option value="/harga/">💰 Tarif & Harga (/harga)</option>
            <option value="/panduan/">📖 Panduan Wisata (/panduan)</option>
            <option value="/tentang-kami/">🏢 Tentang Kami (/tentang-kami)</option>
            <option value="/kontak/">📞 Kontak Kami (/kontak)</option>
          </select>
        </div>
      </div>

      <!-- Center: Device Mode Switcher -->
      <div class="topbar-center">
        <div class="device-switcher" role="group" aria-label="Mode Responsif">
          <button class="btn-device active" data-device="desktop" title="Tampilan Desktop (100%)">
            <span class="icon">🖥️</span>
            <span class="lbl">Desktop</span>
          </button>
          <button class="btn-device" data-device="tablet" title="Tampilan Tablet (768px)">
            <span class="icon">💻</span>
            <span class="lbl">Tablet</span>
          </button>
          <button class="btn-device" data-device="mobile" title="Tampilan Mobile (390px)">
            <span class="icon">📱</span>
            <span class="lbl">Mobile</span>
          </button>
        </div>

        <!-- Clean Preview Toggle -->
        <button class="btn-clean-toggle" id="btn-clean-toggle" title="Sembunyikan / Tampilkan pembatas builder">
          <span class="icon">👁️</span>
          <span class="lbl">Mode Bersih</span>
        </button>
      </div>

      <!-- Right: Actions -->
      <div class="topbar-right">
        <a href="/rss.xml" target="_blank" class="btn-topbar-link" title="Buka RSS 2.0 Feed">
          <span>📡</span> RSS Feed
        </a>
        <button class="btn-save-primary" id="btn-save-changes">
          <span class="icon">💾</span>
          <span class="lbl">Simpan ke Website</span>
        </button>
        <a href="/" target="_blank" id="btn-view-live" class="btn-topbar-link" title="Buka halaman asli di tab baru">
          <span>🌐</span> Buka Tab Baru ↗
        </a>
        <button class="btn-logout" id="btn-logout" title="Keluar dari builder">
          <span>🚪</span> Keluar
        </button>
      </div>
    </header>

    <!-- MAIN SPLIT WORKSPACE: SIDEBAR (LEFT) + LIVE WEBSITE (RIGHT) -->
    <div class="wp-workspace">
      <!-- LEFT SIDEBAR (INSPECTOR & NAVIGATOR) -->
      <aside class="wp-sidebar" id="wp-sidebar">
        <!-- Sidebar Navigation Tabs -->
        <div class="sidebar-tab-nav">
          <button class="side-tab-btn active" data-tab="tab-sections">
            <span class="tab-icon">📑</span>
            <span class="tab-title">Seksi (Drag & Drop)</span>
          </button>
          <button class="side-tab-btn" data-tab="tab-inspector">
            <span class="tab-icon">⚙️</span>
            <span class="tab-title">Inspektor & Grid</span>
          </button>
          <button class="side-tab-btn" data-tab="tab-security">
            <span class="tab-icon">🛡️</span>
            <span class="tab-title">Keamanan & RSS</span>
          </button>
        </div>

        <!-- TAB 1: SEKSI NAVIGATOR & DRAG-AND-DROP TREE -->
        <div class="side-tab-content active" id="tab-sections">
          <div class="side-panel-header">
            <div>
              <h3 class="panel-heading">Susunan Seksi Halaman</h3>
              <p class="panel-desc">Geser (drag & drop) item di bawah untuk mengubah urutan seksi di website secara instan.</p>
            </div>
            <button class="btn-mini-reset" id="btn-reset-order" title="Kembalikan urutan bawaan">
              <span>🔄</span> Reset
            </button>
          </div>

          <!-- Dynamic Draggable Sections Tree -->
          <div class="sections-tree-list" id="sections-tree-list">
            <div class="tree-loading">
              <div class="pulse-loader"></div>
              <span>Mendeteksi seksi website...</span>
            </div>
          </div>

          <div class="sidebar-quick-tip">
            <span class="tip-icon">💡</span>
            <div class="tip-text">
              <strong>Tips Elementor:</strong> Anda juga bisa men-drag seksi atau mengklik tombol naik/turun langsung di halaman website sebelah kanan.
            </div>
          </div>
        </div>

        <!-- TAB 2: INSPEKTOR & GRID LAYOUT -->
        <div class="side-tab-content" id="tab-inspector">
          <div class="side-panel-header">
            <div>
              <h3 class="panel-heading" id="inspector-sec-name">Pilih Seksi</h3>
              <p class="panel-desc">Kustomisasi kolom grid, border, foto, dan judul seksi yang dipilih.</p>
            </div>
            <span class="active-badge" id="inspector-sec-badge">Aktif</span>
          </div>

          <div class="inspector-body" id="inspector-body">
            <!-- Placeholder when no section selected -->
            <div class="inspector-empty" id="inspector-empty">
              <span class="empty-icon">👈</span>
              <p>Klik salah satu seksi di tab <strong>Seksi</strong> atau klik seksi langsung pada website di sebelah kanan untuk mulai mengedit.</p>
            </div>

            <!-- Controls form when a section is selected -->
            <div class="inspector-form" id="inspector-form" style="display: none;">
              <!-- 1. Grid Column Picker -->
              <div class="inspect-group">
                <label class="inspect-label">Layout Grid Kontainer</label>
                <p class="inspect-hint">Ubah pembagian kolom elemen kartu di dalam seksi ini:</p>
                <div class="grid-buttons-row">
                  <button type="button" class="btn-grid-col" data-cols="1">1 Kolom</button>
                  <button type="button" class="btn-grid-col" data-cols="2">2 Kolom</button>
                  <button type="button" class="btn-grid-col" data-cols="3">3 Kolom</button>
                  <button type="button" class="btn-grid-col" data-cols="4">4 Kolom</button>
                </div>
              </div>

              <!-- 2. Border Style Picker -->
              <div class="inspect-group">
                <label class="inspect-label">Gaya Border Kontainer</label>
                <p class="inspect-hint">Kustomisasi bingkai kontainer seksi:</p>
                <div class="border-buttons-row">
                  <button type="button" class="btn-border-style" data-border="none">Polos</button>
                  <button type="button" class="btn-border-style" data-border="subtle">Border Halus</button>
                  <button type="button" class="btn-border-style" data-border="accent">Emerald Accent</button>
                </div>
              </div>

              <!-- 3. Photo & Image Uploader (Direct to Sanity CDN) -->
              <div class="inspect-group">
                <label class="inspect-label">Ganti Foto Seksi (Cloud CDN)</label>
                <p class="inspect-hint">Upload gambar langsung ke Sanity Cloud Asset CDN:</p>
                <div class="image-uploader-card">
                  <div class="img-preview-box" id="inspector-img-preview">
                    <img src="/images/hero-baluran.webp" alt="Preview Foto" id="inspector-current-img" />
                  </div>
                  <div class="uploader-controls">
                    <label for="inspector-file-input" class="btn-upload-file">
                      <span>📷</span> Upload Foto Baru
                    </label>
                    <input type="file" id="inspector-file-input" accept="image/*" style="display:none;" />
                    <span class="upload-status" id="upload-status-text">Format: JPG, PNG, WebP</span>
                  </div>
                </div>
              </div>

              <!-- 4. Text & Headline Editor -->
              <div class="inspect-group">
                <label class="inspect-label" for="inspector-headline">Judul Seksi (Headline)</label>
                <input type="text" id="inspector-headline" class="inspect-input" placeholder="Judul seksi..." />
              </div>

              <div class="inspect-group">
                <label class="inspect-label" for="inspector-subtitle">Sub-Judul / Keterangan</label>
                <textarea id="inspector-subtitle" class="inspect-textarea" rows="3" placeholder="Keterangan seksi..."></textarea>
              </div>

              <!-- 5. Section Visibility -->
              <div class="inspect-group">
                <label class="inspect-label">Visibilitas Seksi</label>
                <div class="toggle-row">
                  <span>Tampilkan seksi ini di halaman website</span>
                  <input type="checkbox" id="inspector-visibility" checked />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: KEAMANAN & RSS FEED -->
        <div class="side-tab-content" id="tab-security">
          <div class="side-panel-header">
            <div>
              <h3 class="panel-heading">Keamanan & SSG</h3>
              <p class="panel-desc">Status zero-leak architecture & sindikasi RSS feed.</p>
            </div>
            <span class="active-badge badge-green">Aktif</span>
          </div>

          <div class="security-info-list">
            <div class="sec-card">
              <div class="sec-card-header">
                <span class="sec-card-icon">🛡️</span>
                <h4>Supabase Auth & Sesi JWT</h4>
              </div>
              <p>Autentikasi operator terhubung langsung dengan Supabase Cloud (Project: <code>zubncszvyvffjyvekajf</code>). Kredensial tidak pernah tersimpan di frontend.</p>
              <div class="sec-tag">● Terproteksi JWT & Sesi Aman</div>
            </div>

            <div class="sec-card">
              <div class="sec-card-header">
                <span class="sec-card-icon">📡</span>
                <h4>RSS 2.0 Feed Terverifikasi</h4>
              </div>
              <p>Feed RSS aktif di <code>/rss.xml</code> menyajikan data paket wisata & destinasi terupdate untuk SEO dan bot agregator.</p>
              <a href="/rss.xml" target="_blank" class="btn-check-rss">Buka /rss.xml ↗</a>
            </div>

            <div class="sec-card">
              <div class="sec-card-header">
                <span class="sec-card-icon">☁️</span>
                <h4>Sanity Cloud Asset CDN</h4>
              </div>
              <p>Semua gambar diunggah langsung ke infrastruktur Cloudflare-backed Sanity CDN global (Project ID: <code>7ox4kuc2</code>).</p>
              <div class="sec-tag">● Fast Edge Delivery</div>
            </div>
          </div>
        </div>

        <!-- SIDEBAR FOOTER -->
        <div class="wp-sidebar-footer">
          <button class="btn-save-sidebar" id="btn-save-sidebar">
            <span>💾</span> Simpan Perubahan
          </button>
        </div>
      </aside>

      <!-- RIGHT VIEWPORT: THE ACTUAL LIVE WEBSITE IN IFRAME -->
      <main class="wp-canvas" id="wp-canvas">
        <div class="canvas-frame-container" id="canvas-frame-container">
          <!-- Loading Overlay -->
          <div class="frame-loader" id="frame-loader">
            <div class="loader-content">
              <div class="pulse-loader"></div>
              <span>Memuat halaman website asli...</span>
            </div>
          </div>

          <!-- THE ACTUAL WEBSITE IFRAME -->
          <iframe 
            id="site-frame" 
            src="/" 
            class="site-frame frame-desktop" 
            title="Pratinjau Live Website Baluran Indonesia"
          ></iframe>
        </div>
      </main>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="builder-toast" id="builder-toast" style="display: none;">
      <span class="toast-icon">✅</span>
      <span class="toast-msg" id="toast-msg">Perubahan berhasil disimpan!</span>
    </div>
  </main>
</Layout>

<style>
  :root {
    --wp-bg-dark: #070d0b;
    --wp-sidebar-bg: #0b1411;
    --wp-topbar-bg: #09120f;
    --wp-border: rgba(16, 185, 129, 0.18);
    --wp-border-subtle: rgba(255, 255, 255, 0.08);
    --wp-accent: #10b981;
    --wp-accent-hover: #059669;
    --wp-accent-light: rgba(16, 185, 129, 0.12);
    --wp-text-main: #f3f4f6;
    --wp-text-muted: #9ca3af;
    --wp-text-dim: #6b7280;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .builder-app {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background-color: var(--wp-bg-dark);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--wp-text-main);
    display: flex;
    flex-direction: column;
  }

  /* TOP CONTROL BAR */
  .wp-topbar {
    height: 56px;
    min-height: 56px;
    background: var(--wp-topbar-bg);
    border-bottom: 1px solid var(--wp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    z-index: 100;
    gap: 1rem;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo .logo-icon {
    font-size: 1.5rem;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  .logo-sub {
    font-size: 0.65rem;
    color: var(--wp-accent);
    font-weight: 600;
  }

  .page-switcher-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #08120f;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--wp-border-subtle);
  }

  .page-select-label {
    font-size: 0.75rem;
    color: var(--wp-text-muted);
    font-weight: 600;
  }

  .page-select {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
  }

  .page-select option {
    background: #0d1815;
    color: #ffffff;
  }

  /* Center: Devices */
  .topbar-center {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .device-switcher {
    display: flex;
    background: #08120f;
    border: 1px solid var(--wp-border-subtle);
    border-radius: 6px;
    padding: 2px;
  }

  .btn-device {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: var(--wp-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-device:hover {
    color: #ffffff;
  }

  .btn-device.active {
    background: var(--wp-accent-light);
    color: var(--wp-accent);
    font-weight: 700;
  }

  .btn-clean-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: #08120f;
    border: 1px solid var(--wp-border-subtle);
    border-radius: 6px;
    color: var(--wp-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-clean-toggle:hover {
    color: #ffffff;
    border-color: var(--wp-border);
  }

  .btn-clean-toggle.active {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border-color: rgba(59, 130, 246, 0.3);
  }

  /* Right Actions */
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-topbar-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: #08120f;
    border: 1px solid var(--wp-border-subtle);
    border-radius: 6px;
    color: var(--wp-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-topbar-link:hover {
    color: #ffffff;
    border-color: var(--wp-border);
  }

  .btn-save-primary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    background: var(--wp-accent);
    border: none;
    border-radius: 6px;
    color: #06120e;
    font-size: 0.825rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-save-primary:hover {
    background: var(--wp-accent-hover);
  }

  .btn-logout {
    padding: 0.4rem 0.65rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 6px;
    color: #f87171;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .btn-logout:hover {
    background: rgba(239, 68, 68, 0.2);
  }

  /* WORKSPACE */
  .wp-workspace {
    display: flex;
    flex: 1;
    height: calc(100vh - 56px);
    overflow: hidden;
  }

  /* LEFT SIDEBAR */
  .wp-sidebar {
    width: 380px;
    min-width: 380px;
    max-width: 380px;
    background: var(--wp-sidebar-bg);
    border-right: 1px solid var(--wp-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 50;
  }

  .sidebar-tab-nav {
    display: flex;
    background: #08100d;
    border-bottom: 1px solid var(--wp-border-subtle);
  }

  .side-tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--wp-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .side-tab-btn:hover {
    color: #ffffff;
  }

  .side-tab-btn.active {
    color: var(--wp-accent);
    border-bottom-color: var(--wp-accent);
    background: rgba(16, 185, 129, 0.05);
  }

  .side-tab-content {
    display: none;
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .side-tab-content.active {
    display: flex;
    flex-direction: column;
  }

  .side-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--wp-border-subtle);
  }

  .panel-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.2rem;
  }

  .panel-desc {
    font-size: 0.75rem;
    color: var(--wp-text-muted);
    line-height: 1.4;
  }

  .btn-mini-reset {
    background: transparent;
    border: 1px solid var(--wp-border-subtle);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-size: 0.7rem;
    color: var(--wp-text-muted);
    cursor: pointer;
  }

  .btn-mini-reset:hover {
    color: #ffffff;
    border-color: var(--wp-border);
  }

  /* SECTIONS TREE */
  .sections-tree-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .tree-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 2rem 0;
    color: var(--wp-text-muted);
    font-size: 0.8rem;
  }

  .pulse-loader {
    width: 14px;
    height: 14px;
    border: 2px solid var(--wp-accent);
    border-radius: 50%;
    animation: pulse 1s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.8); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
    100% { transform: scale(0.8); opacity: 0.5; }
  }

  .section-tree-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.85rem;
    background: #0d1a16;
    border: 1px solid var(--wp-border-subtle);
    border-radius: 8px;
    cursor: grab;
    transition: all 0.2s;
    user-select: none;
  }

  .section-tree-item:hover {
    border-color: var(--wp-border);
    background: #10221c;
  }

  .section-tree-item.selected {
    border-color: var(--wp-accent);
    background: rgba(16, 185, 129, 0.12);
  }

  .section-tree-item.dragging {
    opacity: 0.4;
    border: 1px dashed var(--wp-accent);
  }

  .section-tree-item.drag-over {
    border-top: 3px solid var(--wp-accent);
  }

  .tree-item-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    overflow: hidden;
  }

  .drag-grip {
    color: var(--wp-text-dim);
    font-size: 1.1rem;
    cursor: grab;
  }

  .sec-tree-icon {
    font-size: 1rem;
  }

  .sec-tree-name {
    font-size: 0.825rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tree-item-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .btn-tree-action {
    background: transparent;
    border: none;
    color: var(--wp-text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .btn-tree-action:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
